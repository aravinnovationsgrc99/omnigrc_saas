# ==============================================================================
# OMNiGRC V1 Self-Hosted Deployment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CUSTOMER SECRETS & ENVIRONMENT CONFIGURATION
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_strong_production_password
POSTGRES_DB=omnigrc

# Database & Redis Connection Strings (Internal Docker Network)
DATABASE_URL=postgresql://postgres:replace_with_strong_production_password@postgres:5432/omnigrc?schema=public
DIRECT_URL=postgresql://postgres:replace_with_strong_production_password@postgres:5432/omnigrc?schema=public
REDIS_URL=redis://redis:6379

# JWT Session Secrets (Generate via `openssl rand -hex 32`)
JWT_SECRET=replace_with_hex32_jwt_secret
JWT_REFRESH_SECRET=replace_with_hex32_jwt_refresh_secret

# Optional Outbound Integration Secrets
RESEND_API_KEY=
RESEND_FROM=OMNiGRC Notifications <notifications@yourcompany.com>
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 2. ARAV INNOVATIONS PROVIDED DEPLOYMENT & LICENSE IDENTITIES
# ------------------------------------------------------------------------------
DEPLOYMENT_ID=dep-selfhosted-001
ORGANIZATION_ID=org-selfhosted-001
LICENSE_VERIFICATION_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n..."
LICENSE_VERIFICATION_KEY_ID=arav-license-v1-2026
REGISTRATION_SECRET=reg_sec_assigned_by_arav_control_plane
CONTROL_PLANE_URL=https://control-plane.omnigrc.co
