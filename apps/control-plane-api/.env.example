# ==============================================================================
# OMNiGRC Control Plane API Environment Configuration Template
# ==============================================================================

# Database Configuration (Supabase / Postgres Control Plane DB)
CONTROL_PLANE_DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/control_plane?schema=public"
CONTROL_PLANE_DIRECT_URL="postgresql://postgres:postgrespassword@localhost:5432/control_plane?schema=public"

# Server Configuration
PORT=3002

# Control Plane Admin Key (REQUIRED for administrative REST API endpoints)
# Canonical Env Var: CONTROL_PLANE_ADMIN_KEY
# Canonical Auth Header: x-control-plane-admin-key: <key> OR Authorization: Bearer <key>
CONTROL_PLANE_ADMIN_KEY="replace-with-secure-control-plane-admin-key"

# License Signing Private Key (Ed25519 PKCS8 PEM format)
# REQUIRED in production/staging environments. Fails closed (500) if missing.
CONTROL_PLANE_LICENSE_SIGNING_PRIVATE_KEY=""
CONTROL_PLANE_LICENSE_KEY_ID="arav-license-v1-2026"
