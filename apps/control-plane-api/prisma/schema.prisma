datasource db {
  provider  = "postgresql"
  url       = env("CONTROL_PLANE_DATABASE_URL")
  directUrl = env("CONTROL_PLANE_DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma/control-plane-client"
}

enum DeploymentModel {
  MSSP_SHARED
  PRIVATE_MSSP
  SELF_HOSTED
}

enum DeploymentEnvironment {
  PRODUCTION
  UAT
  DR
  DEVELOPMENT
}

enum ActivationState {
  PENDING
  ACTIVE
  SUSPENDED
  DECOMMISSIONED
}

enum InfrastructureOwner {
  ARAV
  CUSTOMER
}

enum LicenseProduct {
  OMNIGRC
}

enum LicenseStatus {
  TRIAL
  ACTIVE
  EXPIRED
}

model Customer {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agreements  CommercialAgreement[]
  deployments Deployment[]

  @@map("control_plane_customers")
}

model CommercialAgreement {
  id         String   @id @default(uuid())
  customerId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer    Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  licenses    License[]
  deployments Deployment[]

  @@index([customerId])
  @@map("control_plane_commercial_agreements")
}

model License {
  id                    String         @id @default(uuid())
  commercialAgreementId String
  product               LicenseProduct @default(OMNIGRC)
  status                LicenseStatus  @default(TRIAL)
  issuedAt              DateTime       @default(now())
  startsAt              DateTime
  expiresAt             DateTime
  maxDeployments        Int            @default(1)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  commercialAgreement CommercialAgreement @relation(fields: [commercialAgreementId], references: [id], onDelete: Cascade)
  entitlements        Entitlement[]
  deployments         Deployment[]

  @@index([commercialAgreementId])
  @@index([status])
  @@map("licenses")
}

model Entitlement {
  id        String   @id @default(uuid())
  licenseId String
  code      String
  name      String
  value     Json?
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@index([licenseId])
  @@index([code])
  @@map("entitlements")
}

model Deployment {
  id                     String                @id @default(uuid())
  organizationId         String
  customerId             String?
  commercialAgreementId  String?
  licenseId              String?
  deploymentModel        DeploymentModel
  environment            DeploymentEnvironment @default(PRODUCTION)
  version                String                @default("1.0.0")
  activationState        ActivationState       @default(PENDING)
  infrastructureOwner    InfrastructureOwner
  registrationSecretHash String
  lastCheckInAt          DateTime?
  lastActivatedAt        DateTime?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  customer            Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  commercialAgreement CommercialAgreement? @relation(fields: [commercialAgreementId], references: [id], onDelete: SetNull)
  license             License?             @relation(fields: [licenseId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([deploymentModel])
  @@index([activationState])
  @@index([licenseId])
  @@map("deployments")
}

enum OperatorRole {
  PLATFORM_SUPER_ADMIN
  COMMERCIAL_OPERATOR
  OPERATIONS_ENGINEER
  SUPPORT_ENGINEER
  SECURITY_AUDIT
  READ_ONLY_AUDITOR
}

enum OperatorStatus {
  ACTIVE
  SUSPENDED
}

model Operator {
  id                  String         @id @default(uuid())
  email               String         @unique
  passwordHash        String
  fullName            String
  role                OperatorRole
  status              OperatorStatus @default(ACTIVE)
  totpSecret          String?
  mfaEnabled          Boolean        @default(false)
  failedLoginAttempts Int            @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  sessions OperatorSession[]

  @@map("operators")
}

model OperatorSession {
  id               String   @id @default(uuid())
  operatorId       String
  refreshTokenHash String
  ipAddress        String
  userAgent        String
  familyId         String
  isRevoked        Boolean  @default(false)
  expiresAt        DateTime
  createdAt        DateTime @default(now())

  operator Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  @@index([operatorId])
  @@index([familyId])
  @@index([refreshTokenHash])
  @@map("operator_sessions")
}

model ControlPlaneAuditLog {
  id            String   @id @default(uuid())
  actorId       String?
  actorRole     String?
  action        String
  entityType    String
  entityId      String
  ipAddress     String?
  correlationId String?
  result        String?  @default("SUCCESS")
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@map("control_plane_audit_logs")
}

