datasource db {
  provider  = "postgresql"
  url       = env("CONTROL_PLANE_DATABASE_URL")
  directUrl = env("CONTROL_PLANE_DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma/control-plane-client"
}

enum DeploymentModel {
  MSSP_SHARED
  PRIVATE_MSSP
  SELF_HOSTED
}

enum DeploymentEnvironment {
  PRODUCTION
  UAT
  DR
  DEVELOPMENT
}

enum ActivationState {
  PENDING
  ACTIVE
  SUSPENDED
  DECOMMISSIONED
}

enum InfrastructureOwner {
  ARAV
  CUSTOMER
}

enum LicenseProduct {
  OMNIGRC
}

enum LicenseStatus {
  TRIAL
  ACTIVE
  EXPIRED
  SUSPENDED
  REVOKED
}

model Customer {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agreements  CommercialAgreement[]
  deployments Deployment[]

  @@map("control_plane_customers")
}

model CommercialAgreement {
  id         String   @id @default(uuid())
  customerId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer    Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  licenses    License[]
  deployments Deployment[]

  @@index([customerId])
  @@map("control_plane_commercial_agreements")
}

model License {
  id                    String         @id @default(uuid())
  commercialAgreementId String
  product               LicenseProduct @default(OMNIGRC)
  status                LicenseStatus  @default(TRIAL)
  sequence              BigInt         @default(1)
  issuedAt              DateTime       @default(now())
  startsAt              DateTime
  expiresAt             DateTime
  maxDeployments        Int            @default(1)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  commercialAgreement CommercialAgreement @relation(fields: [commercialAgreementId], references: [id], onDelete: Cascade)
  entitlements        Entitlement[]
  deployments         Deployment[]

  @@index([commercialAgreementId])
  @@index([status])
  @@map("licenses")
}

model Entitlement {
  id        String   @id @default(uuid())
  licenseId String
  code      String
  name      String
  value     Json?
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@index([licenseId])
  @@index([code])
  @@map("entitlements")
}

model Deployment {
  id                     String                @id @default(uuid())
  organizationId         String
  customerId             String?
  commercialAgreementId  String?
  licenseId              String?
  deploymentModel        DeploymentModel
  environment            DeploymentEnvironment @default(PRODUCTION)
  version                String                @default("1.0.0")
  activationState        ActivationState       @default(PENDING)
  infrastructureOwner    InfrastructureOwner
  registrationSecretHash String
  lastCheckInAt          DateTime?
  lastActivatedAt        DateTime?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  customer            Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  commercialAgreement CommercialAgreement? @relation(fields: [commercialAgreementId], references: [id], onDelete: SetNull)
  license             License?             @relation(fields: [licenseId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([deploymentModel])
  @@index([activationState])
  @@index([licenseId])
  @@map("deployments")
}

enum ControlState {
  PENDING
  ACTIVE
  SUSPENDED
  DISABLED
  DECOMMISSIONED
}

model OrganizationControlState {
  id                  String       @id @default(uuid())
  organizationId      String       @unique
  state               ControlState @default(PENDING)
  reason              String
  sequence            BigInt       @default(1)
  updatedByOperatorId String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([organizationId])
  @@index([state])
  @@map("control_plane_organization_control_states")
}

model OrganizationStateTransitionLog {
  id             String       @id @default(uuid())
  organizationId String
  previousState  ControlState
  newState       ControlState
  reason         String
  sequence       BigInt
  idempotencyKey String?      @unique
  operatorId     String
  operatorRole   String
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([sequence])
  @@map("control_plane_organization_state_transition_logs")
}

enum OperatorRole {
  PLATFORM_SUPER_ADMIN
  COMMERCIAL_OPERATOR
  OPERATIONS_ENGINEER
  SUPPORT_ENGINEER
  SECURITY_AUDIT
  READ_ONLY_AUDITOR
}

enum OperatorStatus {
  ACTIVE
  SUSPENDED
}

model Operator {
  id                  String         @id @default(uuid())
  email               String         @unique
  passwordHash        String
  fullName            String
  role                OperatorRole
  status              OperatorStatus @default(ACTIVE)
  totpSecret          String?
  mfaEnabled          Boolean        @default(false)
  failedLoginAttempts Int            @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  sessions OperatorSession[]

  breakGlassRequests BreakGlassSession[] @relation("BreakGlassRequester")
  breakGlassApprovals BreakGlassSession[] @relation("BreakGlassApprover")

  @@map("operators")
}

enum BreakGlassStatus {
  REQUESTED
  APPROVED
  EXECUTED
  EXPIRED
  REVOKED
  REJECTED
}

enum BreakGlassOperation {
  EMERGENCY_ORG_SUSPEND
  EMERGENCY_ORG_DISABLE
  EMERGENCY_SERVICE_KILL_SWITCH
  EMERGENCY_DEPLOYMENT_SUSPEND
  EMERGENCY_LICENSE_RECONCILE
}

model BreakGlassSession {
  id                        String              @id @default(uuid())
  requesterOperatorId       String
  approverOperatorId        String?
  executorOperatorId        String?
  status                    BreakGlassStatus    @default(REQUESTED)
  operation                 BreakGlassOperation
  reason                    String
  targetOrganizationId      String?
  targetDeploymentId        String?
  targetServiceCode         String?
  scopeMetadata             Json?
  idempotencyKey            String?             @unique
  expiresAt                 DateTime
  approvedAt                DateTime?
  executedAt                DateTime?
  revokedAt                 DateTime?
  revokedByOperatorId       String?
  isSingleOperatorEmergency Boolean             @default(false)
  postEventReviewStatus     String?             @default("NOT_APPLICABLE")
  postEventReviewedBy       String?
  postEventReviewedAt       DateTime?
  postEventNotes            String?
  originatingIp             String?
  userAgent                 String?
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt

  requesterOperator Operator  @relation("BreakGlassRequester", fields: [requesterOperatorId], references: [id], onDelete: Cascade)
  approverOperator  Operator? @relation("BreakGlassApprover", fields: [approverOperatorId], references: [id], onDelete: SetNull)

  @@index([targetOrganizationId])
  @@index([targetDeploymentId])
  @@index([status])
  @@index([requesterOperatorId])
  @@map("control_plane_break_glass_sessions")
}

model OperatorSession {
  id               String   @id @default(uuid())
  operatorId       String
  refreshTokenHash String
  ipAddress        String
  userAgent        String
  familyId         String
  isRevoked        Boolean  @default(false)
  expiresAt        DateTime
  createdAt        DateTime @default(now())

  operator Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  @@index([operatorId])
  @@index([familyId])
  @@index([refreshTokenHash])
  @@map("operator_sessions")
}

model ControlPlaneAuditLog {
  id            String   @id @default(uuid())
  actorId       String?
  actorRole     String?
  action        String
  entityType    String
  entityId      String
  ipAddress     String?
  correlationId String?
  result        String?  @default("SUCCESS")
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@index([entityType])
  @@map("control_plane_audit_logs")
}

enum ServiceStateEnum {
  AVAILABLE
  DISABLED
  TECHNICAL_OUTAGE
  COMMERCIAL_DISABLED
}

model ServiceCatalog {
  id                         String   @id @default(uuid())
  code                       String   @unique
  name                       String
  description                String?
  category                   String   @default("CORE_GRC")
  isCatalogActive            Boolean  @default(true)
  isCommerciallyControllable Boolean  @default(true)
  isOrgOverridePermitted     Boolean  @default(true)
  hasBackgroundProcessing   Boolean  @default(false)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  globalState GlobalServiceState?
  overrides   OrganizationServiceOverride[]

  @@map("control_plane_service_catalog")
}

model GlobalServiceState {
  id                  String           @id @default(uuid())
  serviceId           String           @unique
  state               ServiceStateEnum @default(AVAILABLE)
  reason              String?
  sequence            BigInt           @default(1)
  updatedByOperatorId String?
  updatedAt           DateTime         @updatedAt

  service ServiceCatalog @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@map("control_plane_global_service_states")
}

model OrganizationServiceOverride {
  id                  String           @id @default(uuid())
  organizationId      String
  serviceId           String
  overrideState       ServiceStateEnum
  reason              String
  sequence            BigInt           @default(1)
  idempotencyKey      String?          @unique
  updatedByOperatorId String
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  service ServiceCatalog @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([organizationId, serviceId])
  @@index([organizationId])
  @@map("control_plane_organization_service_overrides")
}

model ServiceStateTransitionLog {
  id             String           @id @default(uuid())
  scope          String
  organizationId String?
  serviceCode    String
  previousState  ServiceStateEnum?
  newState       ServiceStateEnum
  reason         String
  sequence       BigInt
  idempotencyKey String?          @unique
  operatorId     String
  operatorRole   String
  createdAt      DateTime         @default(now())

  @@index([serviceCode])
  @@index([organizationId])
  @@index([sequence])
  @@map("control_plane_service_state_transition_logs")
}
