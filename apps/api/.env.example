# Database Configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/omnigrc?schema=public"

# Server Configuration
PORT=3001

# JWT Secrets
JWT_SECRET="omnigrc-dev-secret-key-change-in-prod"
JWT_REFRESH_SECRET="omnigrc-dev-refresh-secret-key"

# Redis Configuration (BullMQ Queue)
REDIS_URL="redis://localhost:6379"

# AI Provider API Keys
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""

# Email Notifications (Resend API Key)
RESEND_API_KEY="re_123456789_your_resend_api_key"
RESEND_FROM="OMNiGRC Notifications <notifications@omnigrc.com>"

# Slack Incoming Webhook (Org-level alerts)
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXXXXXX"
