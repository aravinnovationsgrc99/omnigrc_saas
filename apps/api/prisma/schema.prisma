  organizationId  String
  vulnerabilityId String
  assetId         String
  createdAt       DateTime @default(now())

  vulnerability Vulnerability @relation(fields: [vulnerabilityId], references: [id], onDelete: Cascade)
  asset         Asset         @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([vulnerabilityId, assetId])
  @@index([organizationId])
  @@index([vulnerabilityId])
  @@index([assetId])
  @@map("vulnerability_assets")
}

model Policy {
  id                 String       @id @default(uuid())
  organizationId     String
  departmentId       String?
  projectId          String?
  code               String
  title              String
  description        String?
  category           String
  status             PolicyStatus @default(DRAFT)
  ownerId            String
  businessUnit       String?
  publishedVersionId String?
  effectiveDate      DateTime?
  reviewDate         DateTime?
  reviewCadenceDays  Int          @default(365)
  createdById        String
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  deletedAt          DateTime?

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentRef    Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  projectRef       Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  publishedVersion PolicyVersion?    @relation("PublishedPolicyVersion", fields: [publishedVersionId], references: [id], onDelete: SetNull)
  versions         PolicyVersion[]   @relation("PolicyVersions")
  exceptions       PolicyException[]
  evidenceAssociations PolicyEvidence[]
  approvalAssociations PolicyApproval[]

  @@index([organizationId])
  @@index([departmentId])
  @@index([projectId])
  @@index([status])
  @@index([deletedAt])
  @@map("policies")
}

model PolicyVersion {
  id            String   @id @default(uuid())
  policyId      String
  versionNumber String
  content       String
  changeLog     String?
  createdById   String
