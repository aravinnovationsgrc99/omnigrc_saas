  finding  AuditFinding @relation(fields: [findingId], references: [id], onDelete: Cascade)
  evidence Evidence     @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@unique([findingId, evidenceId])
  @@index([organizationId])
  @@index([findingId])
  @@index([evidenceId])
  @@map("audit_finding_evidences")
}

model VendorEvidence {
  id             String   @id @default(uuid())
  organizationId String
  vendorId       String
  evidenceId     String
  attachedAt     DateTime @default(now())

  vendor   Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  evidence Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@unique([vendorId, evidenceId])
  @@index([organizationId])
  @@index([vendorId])
  @@index([evidenceId])
  @@map("vendor_evidences")
}

model VulnerabilityEvidence {
  id              String   @id @default(uuid())
