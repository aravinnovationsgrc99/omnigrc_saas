datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  ANALYST
}

enum PodRegion {
  INDIA
  UK
  EU
  AUSTRALIA
}

enum PodStatus {
  ACTIVE
  INACTIVE
}

enum FrameworkCode {
  ISO27001
  SOC2
  GDPR
  DPDP
  ISO42001
  HIPAA
}

enum AssetType {
  HARDWARE
  SOFTWARE
  VENDOR
  DATA_STORE
  OTHER
}

enum AssetCriticality {
  LOW
  MEDIUM
  HIGH
}

enum RiskStatus {
  OPEN
  IN_TREATMENT
  ACCEPTED
  CLOSED
}

enum MappingStatus {
  SUGGESTED
  APPROVED
  OVERRIDDEN
  REJECTED
}

enum ModelTier {
  TIER_1
  TIER_2
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  UNDER_REVIEW
  COMPLETE
}

enum NotificationType {
  DUE_DATE_REMINDER
  MAPPING_OVERRIDDEN
  TASK_ASSIGNED
  POD_STATUS_CHANGED
  WEEKLY_DIGEST
  RISK_ESCALATION
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum OrgType {
  STANDALONE
  MSSP_PROVIDER
  CLIENT_TENANT
}

model Organization {
  id                  String   @id @default(uuid())
  name                String
  type                OrgType  @default(STANDALONE)
  parentOrganizationId String?
  primaryRegion       String   @default("India")
  slackWebhookUrl     String?
  primaryFramework    String?
  onboardingCompleted Boolean  @default(false)
  createdAt           DateTime @default(now())

  parentOrganization  Organization?  @relation("OrgHierarchy", fields: [parentOrganizationId], references: [id], onDelete: SetNull)
  subOrganizations    Organization[] @relation("OrgHierarchy")

  users           User[]
  regionalPods    RegionalPod[]
  auditLogs       AuditLogEntry[]
  assets          Asset[]
  risks           Risk[]
  controls        Control[]
  complianceTasks ComplianceTask[]
  notifications   Notification[]
  invitations     Invitation[]

  @@index([parentOrganizationId])
  @@map("organizations")
}

model Asset {
  id                  String           @id @default(uuid())
  organizationId      String
  name                String
  type                AssetType
  description         String?
  owner               String
  criticality         AssetCriticality @default(MEDIUM)
  vendorName          String?
  dataResidencyRegion String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  createdById         String
  deletedAt           DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  risks        Risk[]

  @@index([organizationId])
  @@index([deletedAt])
  @@index([type])
  @@index([criticality])
  @@map("assets")
}

model Risk {
  id             String     @id @default(uuid())
  organizationId String
  title          String
  description    String?
  likelihood     Int
  impact         Int
  score          Int
  status         RiskStatus @default(OPEN)
  owner          String
  assetId        String?
  treatmentPlan  String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  createdById    String
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  asset        Asset?       @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([deletedAt])
  @@index([status])
  @@index([score])
  @@index([assetId])
  @@map("risks")
}

model User {
  id                 String   @id @default(uuid())
  organizationId     String
  name               String
  email              String   @unique
  passwordHash       String
  role                  Role         @default(ANALYST)
  emailNotifications    Boolean      @default(true)
  passwordSetupRequired Boolean      @default(false)
  createdAt             DateTime     @default(now())

  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  notifications   Notification[]
  invitationsSent Invitation[]   @relation("InvitedUsers")

  @@index([organizationId])
  @@map("users")
}

model Notification {
  id             String           @id @default(uuid())
  organizationId String
  userId         String
  type           NotificationType
  message        String
  entityType     String
  entityId       String
  read           Boolean          @default(false)
  emailSentAt    DateTime?
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId])
  @@index([read])
  @@map("notifications")
}

model Invitation {
  id             String           @id @default(uuid())
  organizationId String
  email          String
  role           Role             @default(ANALYST)
  tokenHash      String           @unique
  status         InvitationStatus @default(PENDING)
  invitedById    String
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InvitedUsers", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@index([status])
  @@index([tokenHash])
  @@map("invitations")
}

model RegionalPod {
  id             String    @id @default(uuid())
  organizationId String
  region         PodRegion
  status         PodStatus @default(INACTIVE)
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, region])
  @@index([organizationId])
  @@map("regional_pods")
}

model Framework {
  id        String        @id @default(uuid())
  code      FrameworkCode @unique
  name      String
  createdAt DateTime      @default(now())

  clauses FrameworkClause[]

  @@map("frameworks")
}

model FrameworkClause {
  id          String   @id @default(uuid())
  frameworkId String
  code        String
  title       String
  createdAt   DateTime @default(now())

  framework Framework               @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  mappings  ControlFrameworkMapping[]

  @@index([frameworkId])
  @@map("framework_clauses")
}

model Control {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  description    String
  category       String?
  createdById    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization    Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mappings        ControlFrameworkMapping[]
  complianceTasks ComplianceTask[]

  @@index([organizationId])
  @@index([deletedAt])
  @@map("controls")
}

model ControlFrameworkMapping {
  id                String        @id @default(uuid())
  controlId         String
  frameworkClauseId String
  status            MappingStatus @default(SUGGESTED)
  confidenceScore   Float?
  modelTier         ModelTier     @default(TIER_1)
  reviewedById      String?
  reviewedAt        DateTime?
  createdAt         DateTime      @default(now())

  control         Control         @relation(fields: [controlId], references: [id], onDelete: Cascade)
  frameworkClause FrameworkClause @relation(fields: [frameworkClauseId], references: [id], onDelete: Cascade)

  @@unique([controlId, frameworkClauseId])
  @@index([controlId])
  @@index([frameworkClauseId])
  @@index([status])
  @@map("control_framework_mappings")
}

model ComplianceTask {
  id             String     @id @default(uuid())
  organizationId String
  title          String
  description    String?
  status         TaskStatus @default(NOT_STARTED)
  owner          String
  dueDate        DateTime?
  controlId      String?
  createdById    String
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  control      Control?     @relation(fields: [controlId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([deletedAt])
  @@index([status])
  @@index([dueDate])
  @@index([controlId])
  @@map("compliance_tasks")
}

model AuditLogEntry {
  id             String   @id @default(uuid())
  organizationId String
  actorId        String
  action         String
  entityType     String
  entityId       String
  metadata       Json
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([actorId])
  @@map("audit_log_entries")
}
