  policyId       String
  evidenceId     String
  attachedAt     DateTime @default(now())

  policy   Policy   @relation(fields: [policyId], references: [id], onDelete: Cascade)
  evidence Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@unique([policyId, evidenceId])
  @@index([organizationId])
  @@index([policyId])
  @@index([evidenceId])
  @@map("policy_evidences")
}

model AuditCheckItemEvidence {
  id             String   @id @default(uuid())
  organizationId String
  checkItemId    String
  evidenceId     String
  attachedAt     DateTime @default(now())

  checkItem AuditCheckItem @relation(fields: [checkItemId], references: [id], onDelete: Cascade)
