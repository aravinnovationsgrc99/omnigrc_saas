  obligation                 RegulatoryObligation    @relation(fields: [obligationId], references: [id], onDelete: Cascade)
  publication                RegulatoryPublication?  @relation(fields: [publicationId], references: [id], onDelete: SetNull)
  catalogueEntry             RegulatoryCatalogueEntry? @relation(fields: [catalogueEntryId], references: [id], onDelete: SetNull)
  history                    RegulatoryApplicabilityHistory[]
  gapAssessments             RegulatoryControlGapAssessment[]

  @@unique([organizationId, obligationId])
  @@index([organizationId])
  @@index([obligationId])
  @@index([catalogueEntryId])
  @@index([outcome])
  @@index([determinationType])
  @@index([isHumanReviewed])
  @@map("regulatory_applicability_assessments")
}

model RegulatoryApplicabilityHistory {
  id                  String               @id @default(uuid())
  assessmentId        String
  organizationId      String
  previousOutcome     ApplicabilityOutcome
  newOutcome          ApplicabilityOutcome
  determinationType   DeterminationType
  rationale           String
  actorId             String
  changedAt           DateTime             @default(now())
  evaluatedAttributes Json?

  assessment          RegulatoryApplicabilityAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  organization        Organization                      @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([assessmentId])
  @@index([organizationId])
  @@map("regulatory_applicability_histories")
}

enum ObligationMappingMethod {
  HUMAN_AUTHORED
  RULE_SUGGESTED
  AI_SUGGESTED
}

model RegulatoryObligationControlMapping {
  id                   String                   @id @default(uuid())
  organizationId       String
  obligationId         String
  controlId            String
  publicationId        String?
  publicationVersionId String?
  frameworkReferenceId String?
  mappingMethod        ObligationMappingMethod  @default(RULE_SUGGESTED)
  status               MappingStatus            @default(SUGGESTED)
  confidence           ObligationConfidence     @default(HIGH)
  rationale            String
  sourceExcerpt        String?
  ruleMatched          String?
  suggestedById        String?
  reviewedById         String?
  reviewedAt           DateTime?
  reviewNotes          String?
  reassessmentCount    Int                      @default(0)
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  organization         Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  obligation           RegulatoryObligation     @relation(fields: [obligationId], references: [id], onDelete: Cascade)
  control              Control                  @relation(fields: [controlId], references: [id], onDelete: Cascade)
  publication          RegulatoryPublication?   @relation(fields: [publicationId], references: [id], onDelete: SetNull)
  publicationVersion   RegulatoryPublicationVersion? @relation(fields: [publicationVersionId], references: [id], onDelete: SetNull)
  frameworkReference   FrameworkReference?      @relation(fields: [frameworkReferenceId], references: [id], onDelete: SetNull)
  history              RegulatoryObligationControlMappingHistory[]
  gapAssessments       RegulatoryControlGapAssessment[]

  @@unique([organizationId, obligationId, controlId])
  @@index([organizationId])
  @@index([obligationId])
  @@index([controlId])
  @@index([status])
  @@index([mappingMethod])
  @@map("regulatory_obligation_control_mappings")
}

model RegulatoryObligationControlMappingHistory {
  id                String                  @id @default(uuid())
  mappingId         String
  organizationId    String
  previousStatus    MappingStatus
  newStatus         MappingStatus
  previousRationale String?
  newRationale      String
  actorId           String
  reviewNotes       String?
  changedAt         DateTime                @default(now())

  mapping           RegulatoryObligationControlMapping @relation(fields: [mappingId], references: [id], onDelete: Cascade)
  organization      Organization                       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([mappingId])
  @@index([organizationId])
  @@map("regulatory_obligation_control_mapping_histories")
}

enum ControlGapOutcome {
  NO_MAPPING
  CONTROL_INELIGIBLE
  NOT_IMPLEMENTED
  PARTIALLY_IMPLEMENTED
  IMPLEMENTED
  UNKNOWN_IMPLEMENTATION
}

enum EvidenceSufficiencyOutcome {
  SUFFICIENT
  INSUFFICIENT
  STALE
  UNVERIFIED
  NOT_ASSESSED
}

model RegulatoryControlGapAssessment {
  id                   String                     @id @default(uuid())
  organizationId       String
  obligationId         String
  mappingId            String?
  controlId            String?
  publicationId        String?
  publicationVersionId String?
  applicabilityId      String?
  gapOutcome           ControlGapOutcome
  evidenceOutcome      EvidenceSufficiencyOutcome @default(NOT_ASSESSED)
  determinationType    DeterminationType          @default(RULE_DERIVED)
  confidence           ObligationConfidence       @default(HIGH)
  gapRationale         String
  evidenceRationale    String
  ruleMatched          String?
  evaluatedRecords     Json
  isHumanReviewed      Boolean                    @default(false)
  reviewedById         String?
  reviewedAt           DateTime?
  reviewNotes          String?
  reassessmentCount    Int                        @default(0)
  assessedById         String?
  assessedAt           DateTime                   @default(now())
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt

  organization         Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  obligation           RegulatoryObligation       @relation(fields: [obligationId], references: [id], onDelete: Cascade)
  mapping              RegulatoryObligationControlMapping? @relation(fields: [mappingId], references: [id], onDelete: SetNull)
  control              Control?                   @relation(fields: [controlId], references: [id], onDelete: SetNull)
  publication          RegulatoryPublication?     @relation(fields: [publicationId], references: [id], onDelete: SetNull)
  publicationVersion   RegulatoryPublicationVersion? @relation(fields: [publicationVersionId], references: [id], onDelete: SetNull)
  applicabilityAssessment RegulatoryApplicabilityAssessment? @relation(fields: [applicabilityId], references: [id], onDelete: SetNull)
  history              RegulatoryControlGapAssessmentHistory[]

  @@unique([organizationId, obligationId])
  @@index([organizationId])
  @@index([obligationId])
  @@index([controlId])
  @@index([mappingId])
  @@index([gapOutcome])
  @@index([evidenceOutcome])
  @@index([isHumanReviewed])
  @@map("regulatory_control_gap_assessments")
}

model RegulatoryControlGapAssessmentHistory {
  id                      String                     @id @default(uuid())
  assessmentId            String
  organizationId          String
  previousGapOutcome      ControlGapOutcome
  newGapOutcome           ControlGapOutcome
  previousEvidenceOutcome EvidenceSufficiencyOutcome
  newEvidenceOutcome      EvidenceSufficiencyOutcome
  determinationType       DeterminationType
  gapRationale            String
  evidenceRationale       String
  actorId                 String
  reviewNotes             String?
  evaluatedRecords        Json?
  changedAt               DateTime                   @default(now())

  assessment              RegulatoryControlGapAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  organization            Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([assessmentId])
  @@index([organizationId])
  @@map("regulatory_control_gap_assessment_histories")
}

