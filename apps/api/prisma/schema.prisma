  name           String
  isDefault      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("policy_categories")
}

// Phase 12 Models: AuditPlan, AuditSchedule, AuditAssessment, AuditCheckItem, AuditEvidence, AuditFinding, AuditCapa

enum AuditPlanStatus {
  DRAFT
  PLANNED
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

enum AuditScheduleStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AuditAssessmentStatus {
  IN_PROGRESS
  UNDER_REVIEW
  COMPLETED
}

enum AuditCheckResult {
  NOT_EVALUATED
  COMPLIANT
  PARTIALLY_COMPLIANT
  NON_COMPLIANT
  NOT_APPLICABLE
}

enum FindingStatus {
  OPEN
  IN_REMEDIATION
  READY_FOR_VERIFICATION
  VERIFIED
  CLOSED
}

enum CapaStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  VERIFIED
  CLOSED
}

model AuditPlan {
  id               String          @id @default(uuid())
  organizationId   String
  departmentId     String?
  projectId        String?
  title            String
  objective        String?
  scope            String?
  frameworkCode    String?
  frameworkId      String?
  frameworkVersionId String?
  ownerId          String
  plannedStartDate DateTime?
  plannedEndDate   DateTime?
  status           AuditPlanStatus @default(DRAFT)
  createdById      String
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentRef    Department?        @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  projectRef       Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  frameworkRef     Framework?         @relation(fields: [frameworkId], references: [id], onDelete: SetNull)
  versionRef       FrameworkVersion?  @relation(fields: [frameworkVersionId], references: [id], onDelete: SetNull)
  schedules        AuditSchedule[]
  assessments      AuditAssessment[]
  scopeReferences  AuditPlanFrameworkReference[]

  @@index([organizationId])
  @@index([departmentId])
  @@index([projectId])
  @@index([frameworkId])
  @@index([frameworkVersionId])
  @@index([status])
  @@map("audit_plans")
}

model AuditPlanFrameworkReference {
  id                   String             @id @default(uuid())
  auditPlanId          String
  frameworkReferenceId String
  createdAt            DateTime           @default(now())

  auditPlan          AuditPlan          @relation(fields: [auditPlanId], references: [id], onDelete: Cascade)
  frameworkReference FrameworkReference @relation(fields: [frameworkReferenceId], references: [id], onDelete: Cascade)

  @@unique([auditPlanId, frameworkReferenceId], map: "audit_plan_framework_references_auditPlanId_frameworkReferenceI")
  @@index([auditPlanId])
  @@index([frameworkReferenceId])
  @@map("audit_plan_framework_references")
}

model AuditSchedule {
  id                 String              @id @default(uuid())
  organizationId     String
  auditPlanId        String
  scheduledStartDate DateTime
  scheduledEndDate   DateTime
  leadAuditorId      String
  status             AuditScheduleStatus @default(SCHEDULED)
  recurrence         ObligationCadence?
  nextAuditDate      DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  auditPlan   AuditPlan         @relation(fields: [auditPlanId], references: [id], onDelete: Cascade)
  assessments AuditAssessment[]

  @@index([organizationId])
  @@index([auditPlanId])
  @@index([status])
  @@map("audit_schedules")
}

model AuditAssessment {
  id             String                @id @default(uuid())
  organizationId String
  auditPlanId    String
  scheduleId     String?
  auditorId      String
  status         AuditAssessmentStatus @default(IN_PROGRESS)
  score          Float                 @default(0)
  summary        String?
  startedAt      DateTime              @default(now())
  completedAt    DateTime?
  createdById    String
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  auditPlan  AuditPlan        @relation(fields: [auditPlanId], references: [id], onDelete: Cascade)
  schedule   AuditSchedule?   @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  checkItems AuditCheckItem[]
  findings   AuditFinding[]

  @@index([organizationId])
  @@index([auditPlanId])
  @@index([status])
  @@map("audit_assessments")
}

model AuditCheckItem {
  id             String           @id @default(uuid())
  organizationId String
  assessmentId   String
  controlId      String?
  title          String
  description    String?
  result         AuditCheckResult @default(NOT_EVALUATED)
  notes          String?
  createdById    String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  assessment AuditAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  control    Control?         @relation(fields: [controlId], references: [id], onDelete: SetNull)
  evidence   AuditEvidence[]
  findings   AuditFinding[]
  evidenceAssociations AuditCheckItemEvidence[]

  @@index([organizationId])
  @@index([assessmentId])
  @@index([controlId])
  @@index([result])
  @@map("audit_check_items")
}

model AuditEvidence {
  id             String   @id @default(uuid())
  organizationId String
  checkItemId    String?
  findingId      String?
  fileName       String
  fileUrl        String
  fileSize       Int?
  mimeType       String?
  uploadedById   String
  createdAt      DateTime @default(now())

  checkItem AuditCheckItem? @relation(fields: [checkItemId], references: [id], onDelete: Cascade)
  finding   AuditFinding?   @relation(fields: [findingId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([checkItemId])
  @@index([findingId])
  @@map("audit_evidences")
}

model AuditFinding {
  id                String                @id @default(uuid())
  organizationId    String
  assessmentId      String
  checkItemId       String?
  title             String
  description       String?
  severity          VulnerabilitySeverity @default(MEDIUM)
  status            FindingStatus         @default(OPEN)
  ownerId           String
  dueDate           DateTime?
  riskId            String?
  remediationPlan   String?
  verificationNotes String?
  verifiedById      String?
  verifiedAt        DateTime?
  createdById       String
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  assessment AuditAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  checkItem  AuditCheckItem? @relation(fields: [checkItemId], references: [id], onDelete: SetNull)
  risk       Risk?           @relation(fields: [riskId], references: [id], onDelete: SetNull)
  capas      AuditCapa[]
  evidence   AuditEvidence[]
  evidenceAssociations AuditFindingEvidence[]
  approvalAssociations AuditFindingApproval[]

  @@index([organizationId])
  @@index([assessmentId])
  @@index([status])
  @@index([severity])
  @@index([ownerId])
  @@map("audit_findings")
}

model AuditCapa {
  id               String     @id @default(uuid())
  organizationId   String
  findingId        String
  title            String
  correctiveAction String
  preventiveAction String?
  ownerId          String
  dueDate          DateTime?
  status           CapaStatus @default(OPEN)
  completedAt      DateTime?
  verifiedById     String?
  verifiedAt       DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  finding AuditFinding @relation(fields: [findingId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([findingId])
  @@index([status])
  @@map("audit_capas")
}

// Phase 14 Model: UserDashboardPreference

model UserDashboardPreference {
  id             String   @id @default(uuid())
  userId         String
  organizationId String
  configJson     Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
  @@map("user_dashboard_preferences")
}

// Phase 17 Model: Incident Management

enum IncidentSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum IncidentStatus {
  OPEN
  IN_PROGRESS
  CONTAINED
  RESOLVED
  CLOSED
}

model Incident {
  id                   String           @id @default(uuid())
  organizationId       String
  departmentId         String?
  projectId            String?
  title                String
  description          String?
  category             String?
  priority             String?
  severity             IncidentSeverity @default(MEDIUM)
  status               IncidentStatus   @default(OPEN)
  owner                String
  businessUnit         String?
  detectedAt           DateTime         @default(now())
  containedAt          DateTime?
  resolvedAt           DateTime?
  dueDate              DateTime?
  rootCause            String?
  investigationDetails String?
  affectedAssetId      String?
  createdById          String
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  deletedAt            DateTime?

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentRef Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  projectRef    Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  affectedAsset Asset?       @relation(fields: [affectedAssetId], references: [id], onDelete: SetNull)
  actions       IncidentAction[]
  evidenceAssociations IncidentEvidence[]
  approvalAssociations IncidentApproval[]

  @@index([organizationId])
  @@index([departmentId])
  @@index([projectId])
  @@index([status])
  @@index([severity])
  @@index([category])
  @@index([deletedAt])
  @@map("incidents")
}

model IncidentAction {
  id             String     @id @default(uuid())
  organizationId String
  incidentId     String
  title          String
  description    String?
  actionType     String     @default("CORRECTIVE")
  owner          String
  dueDate        DateTime?
  status         CapaStatus @default(OPEN)
  completedAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  incident       Incident   @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([incidentId])
  @@index([status])
  @@map("incident_actions")
}

model OrganizationMembership {
  id             String              @id @default(uuid())
  organizationId String
  userId         String
  role           Role                @default(ANALYST)
  status         ProductAccessStatus @default(ACTIVE)
  grantedAt      DateTime            @default(now())
  revokedAt      DateTime?
  revokedById    String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User             @relation("UserMemberships", fields: [userId], references: [id], onDelete: Cascade)
  revokedBy    User?            @relation("RevokedMemberships", fields: [revokedById], references: [id], onDelete: SetNull)
  departments  UserDepartment[]
  projects     UserProject[]

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@index([status])
  @@map("organization_memberships")
}

model Department {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  code           String?
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projects     Project[]
  memberships  UserDepartment[]

  assets          Asset[]
  risks           Risk[]
  controls        Control[]
  policies        Policy[]
  complianceTasks ComplianceTask[]
  vendors         Vendor[]
  vulnerabilities Vulnerability[]
  incidents       Incident[]
  auditPlans      AuditPlan[]
  evidences       Evidence[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("departments")
}

model Project {
  id             String   @id @default(uuid())
  organizationId String
  departmentId   String
  name           String
  code           String?
  description    String?
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department   Department    @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  memberships  UserProject[]

  assets          Asset[]
  risks           Risk[]
  controls        Control[]
  policies        Policy[]
  complianceTasks ComplianceTask[]
  vendors         Vendor[]
  vulnerabilities Vulnerability[]
  incidents       Incident[]
  auditPlans      AuditPlan[]
  evidences       Evidence[]

  @@unique([departmentId, name])
  @@index([organizationId])
  @@index([departmentId])
  @@map("projects")
}

model UserDepartment {
  id           String   @id @default(uuid())
  membershipId String
  departmentId String
  assignedAt   DateTime @default(now())

  membership OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  department Department             @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([membershipId, departmentId])
  @@index([membershipId])
  @@index([departmentId])
  @@map("user_departments")
}

model UserProject {
  id           String   @id @default(uuid())
  membershipId String
  projectId    String
  assignedAt   DateTime @default(now())

  membership OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  project    Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([membershipId, projectId])
  @@index([membershipId])
  @@index([projectId])
  @@map("user_projects")
}

// --------------------------------------------------
// PHASE 3 — UNIVERSAL EVIDENCE & PROOF VAULT MODELS
// --------------------------------------------------

enum EvidenceType {
  DOCUMENT
  SPREADSHEET
  IMAGE
  CONFIG_EXPORT
  SYSTEM_LOG
  CERTIFICATE
  EXTERNAL_LINK
  OTHER
}

enum EvidenceStatus {
  PENDING
  ACTIVE
  QUARANTINED
  ARCHIVED
  DELETED
}

enum EvidenceScanStatus {
  PENDING_SCAN
  CLEAN
  QUARANTINED
  SCAN_FAILED
}

model Evidence {
  id             String             @id @default(uuid())
  organizationId String
  departmentId   String?
  projectId      String?
  title          String
  description    String?
  evidenceType   EvidenceType       @default(DOCUMENT)
  fileName       String
  fileSize       Int
  mimeType       String
  storageKey     String             @unique
  checksum       String?
  status         EvidenceStatus     @default(ACTIVE)
  scanStatus     EvidenceScanStatus @default(CLEAN)
  uploadedById   String
  retentionUntil DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  deletedAt      DateTime?

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentRef Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  projectRef    Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)

  controlAssociations        ControlEvidence[]
  riskAssociations           RiskEvidence[]
  policyAssociations         PolicyEvidence[]
  auditCheckAssociations     AuditCheckItemEvidence[]
  auditFindingAssociations  AuditFindingEvidence[]
  vendorAssociations         VendorEvidence[]
  vulnerabilityAssociations  VulnerabilityEvidence[]
  incidentAssociations       IncidentEvidence[]
  frameworkReferences        EvidenceFrameworkReference[]
  approvalAssociations       EvidenceApproval[]
  documentAnalyses           DocumentAnalysis[]

  @@index([organizationId])
  @@index([departmentId])
  @@index([projectId])
  @@index([status])
  @@index([scanStatus])
  @@index([uploadedById])
  @@map("evidences")
}

model ControlEvidence {
  id             String   @id @default(uuid())
  organizationId String
  controlId      String
  evidenceId     String
  attachedAt     DateTime @default(now())

  control  Control  @relation(fields: [controlId], references: [id], onDelete: Cascade)
  evidence Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@unique([controlId, evidenceId])
  @@index([organizationId])
  @@index([controlId])
  @@index([evidenceId])
  @@map("control_evidences")
}

model RiskEvidence {
  id             String   @id @default(uuid())
  organizationId String
  riskId         String
  evidenceId     String
  attachedAt     DateTime @default(now())

  risk     Risk     @relation(fields: [riskId], references: [id], onDelete: Cascade)
  evidence Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@unique([riskId, evidenceId])
  @@index([organizationId])
  @@index([riskId])
  @@index([evidenceId])
  @@map("risk_evidences")
}

model PolicyEvidence {
  id             String   @id @default(uuid())
  organizationId String
  policyId       String
  evidenceId     String
  attachedAt     DateTime @default(now())

  policy   Policy   @relation(fields: [policyId], references: [id], onDelete: Cascade)
  evidence Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@unique([policyId, evidenceId])
  @@index([organizationId])
  @@index([policyId])
  @@index([evidenceId])
  @@map("policy_evidences")
}

model AuditCheckItemEvidence {
  id             String   @id @default(uuid())
  organizationId String
  checkItemId    String
  evidenceId     String
  attachedAt     DateTime @default(now())

  checkItem AuditCheckItem @relation(fields: [checkItemId], references: [id], onDelete: Cascade)
  evidence  Evidence       @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@unique([checkItemId, evidenceId])
  @@index([organizationId])
  @@index([checkItemId])
  @@index([evidenceId])
  @@map("audit_check_item_evidences")
}

model AuditFindingEvidence {
  id             String   @id @default(uuid())
  organizationId String
  findingId      String
  evidenceId     String
  attachedAt     DateTime @default(now())

  finding  AuditFinding @relation(fields: [findingId], references: [id], onDelete: Cascade)
  evidence Evidence     @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@unique([findingId, evidenceId])
  @@index([organizationId])
  @@index([findingId])
  @@index([evidenceId])
  @@map("audit_finding_evidences")
}

model VendorEvidence {
  id             String   @id @default(uuid())
  organizationId String
  vendorId       String
  evidenceId     String
  attachedAt     DateTime @default(now())

  vendor   Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  evidence Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@unique([vendorId, evidenceId])
  @@index([organizationId])
  @@index([vendorId])
  @@index([evidenceId])
  @@map("vendor_evidences")
}

model VulnerabilityEvidence {
  id              String   @id @default(uuid())
  organizationId  String
  vulnerabilityId String
  evidenceId      String
  attachedAt      DateTime @default(now())

  vulnerability Vulnerability @relation(fields: [vulnerabilityId], references: [id], onDelete: Cascade)
  evidence      Evidence      @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@unique([vulnerabilityId, evidenceId])
  @@index([organizationId])
  @@index([vulnerabilityId])
  @@index([evidenceId])
  @@map("vulnerability_evidences")
}

model IncidentEvidence {
  id             String   @id @default(uuid())
  organizationId String
  incidentId     String
  evidenceId     String
  attachedAt     DateTime @default(now())

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  evidence Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@unique([incidentId, evidenceId])
  @@index([organizationId])
  @@index([incidentId])
  @@index([evidenceId])
  @@map("incident_evidences")
}

model EvidenceFrameworkReference {
  id                   String   @id @default(uuid())
  evidenceId           String
  frameworkReferenceId String
  createdAt            DateTime @default(now())

  evidence           Evidence           @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  frameworkReference FrameworkReference @relation(fields: [frameworkReferenceId], references: [id], onDelete: Cascade)

  @@unique([evidenceId, frameworkReferenceId])
  @@index([evidenceId])
  @@index([frameworkReferenceId])
  @@map("evidence_framework_references")
