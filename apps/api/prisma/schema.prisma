  @@index([evidenceId])
  @@index([frameworkReferenceId])
  @@map("evidence_framework_references")
}

// --------------------------------------------------
// PHASE 4 — UNIVERSAL APPROVAL & DECISION ENGINE MODELS
// --------------------------------------------------

enum ApprovalWorkflowStatus {
  ACTIVE
  INACTIVE
}

enum ApprovalInstanceStatus {
  DRAFT
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
  CHANGES_REQUESTED
  CANCELLED
}

enum ApprovalStepStatus {
  PENDING
  ACTIVE
  APPROVED
  REJECTED
  CHANGES_REQUESTED
  SKIPPED
}

enum ApproverType {
  ROLE
  DEPARTMENT
  PROJECT
  SPECIFIC_USER
  ORGANIZATION_AUTHORITY
}

enum DecisionAction {
  APPROVE
  REJECT
  REQUEST_CHANGES
}

enum ApprovalPurpose {
  POLICY_APPROVAL
  POLICY_EXCEPTION
  RISK_ACCEPTANCE
  RISK_TREATMENT
  CONTROL_SIGNOFF
  FINDING_VERIFICATION
  FINDING_CLOSURE
  VENDOR_ASSESSMENT
  VULNERABILITY_REMEDIATION
  VULNERABILITY_RISK_ACCEPTANCE
  INCIDENT_RESOLUTION
  INCIDENT_CLOSURE
  EVIDENCE_VERIFICATION
}

model ApprovalWorkflow {
  id                     String                 @id @default(uuid())
  organizationId         String
  name                   String
  description            String?
  applicableResourceType String
  status                 ApprovalWorkflowStatus @default(ACTIVE)
  allowSelfApproval      Boolean                @default(false)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  steps        ApprovalWorkflowStep[]
  instances    ApprovalInstance[]

  @@index([organizationId])
  @@index([applicableResourceType])
  @@index([status])
  @@map("approval_workflows")
}

model ApprovalWorkflowStep {
  id                 String       @id @default(uuid())
  workflowId         String
  stepNumber         Int
  name               String
  approverType       ApproverType @default(ROLE)
  targetRole         Role?
  targetDepartmentId String?
  targetProjectId    String?
  specificUserId     String?
  dueDays            Int?

  workflow ApprovalWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([workflowId, stepNumber])
  @@index([workflowId])
  @@map("approval_workflow_steps")
}

model ApprovalInstance {
  id                   String                 @id @default(uuid())
  organizationId       String
  workflowId           String?
  title                String
  description          String?
  resourceType         String
  resourceId           String
  requesterId          String
  status               ApprovalInstanceStatus @default(PENDING)
  purpose              ApprovalPurpose?
  currentStepNumber    Int                    @default(1)
  dueAt                DateTime?
  frameworkReferenceId String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  completedAt          DateTime?

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workflow           ApprovalWorkflow?   @relation(fields: [workflowId], references: [id], onDelete: SetNull)
  frameworkReference FrameworkReference? @relation(fields: [frameworkReferenceId], references: [id], onDelete: SetNull)

  steps                      ApprovalInstanceStep[]
  decisions                  ApprovalDecision[]
  controlAssociations        ControlApproval[]
  riskAssociations           RiskApproval[]
  policyAssociations         PolicyApproval[]
  findingAssociations        AuditFindingApproval[]
  vendorAssessmentAssociations VendorAssessmentApproval[]
  vulnerabilityAssociations  VulnerabilityApproval[]
  incidentAssociations       IncidentApproval[]
  policyExceptionAssociations PolicyExceptionApproval[]
  evidenceAssociations       EvidenceApproval[]

  @@index([organizationId])
  @@index([resourceType, resourceId])
  @@index([requesterId])
  @@index([status])
  @@map("approval_instances")
}

model ApprovalInstanceStep {
  id                 String             @id @default(uuid())
  approvalInstanceId String
  stepNumber         Int
  name               String
  approverType       ApproverType       @default(ROLE)
  targetRole         Role?
  targetDepartmentId String?
  targetProjectId    String?
  specificUserId     String?
  status             ApprovalStepStatus @default(PENDING)
  activatedAt        DateTime?
  completedAt        DateTime?

  approvalInstance ApprovalInstance @relation(fields: [approvalInstanceId], references: [id], onDelete: Cascade)

  decisions ApprovalDecision[]

  @@unique([approvalInstanceId, stepNumber])
  @@index([approvalInstanceId])
  @@index([status])
  @@map("approval_instance_steps")
}

model ApprovalDecision {
  id                 String         @id @default(uuid())
  organizationId     String
  approvalInstanceId String
  stepId             String?
  actorId            String
  action             DecisionAction
  comment            String?
  createdAt          DateTime       @default(now())

  approvalInstance ApprovalInstance      @relation(fields: [approvalInstanceId], references: [id], onDelete: Cascade)
  step             ApprovalInstanceStep? @relation(fields: [stepId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([approvalInstanceId])
  @@index([actorId])
  @@map("approval_decisions")
}

model ControlApproval {
  id                 String   @id @default(uuid())
  organizationId     String
  controlId          String
  approvalInstanceId String
  attachedAt         DateTime @default(now())

  control          Control          @relation(fields: [controlId], references: [id], onDelete: Cascade)
  approvalInstance ApprovalInstance @relation(fields: [approvalInstanceId], references: [id], onDelete: Cascade)

  @@unique([controlId, approvalInstanceId])
  @@index([organizationId])
  @@index([controlId])
  @@map("control_approvals")
}

model RiskApproval {
  id                 String   @id @default(uuid())
  organizationId     String
  riskId             String
  approvalInstanceId String
  attachedAt         DateTime @default(now())

  risk             Risk             @relation(fields: [riskId], references: [id], onDelete: Cascade)
  approvalInstance ApprovalInstance @relation(fields: [approvalInstanceId], references: [id], onDelete: Cascade)

  @@unique([riskId, approvalInstanceId])
  @@index([organizationId])
  @@index([riskId])
  @@map("risk_approvals")
}

model PolicyApproval {
  id                 String   @id @default(uuid())
  organizationId     String
  policyId           String
  approvalInstanceId String
  attachedAt         DateTime @default(now())

  policy           Policy           @relation(fields: [policyId], references: [id], onDelete: Cascade)
  approvalInstance ApprovalInstance @relation(fields: [approvalInstanceId], references: [id], onDelete: Cascade)

  @@unique([policyId, approvalInstanceId])
  @@index([organizationId])
  @@index([policyId])
  @@map("policy_approvals")
}

model AuditFindingApproval {
  id                 String   @id @default(uuid())
  organizationId     String
  findingId          String
  approvalInstanceId String
  attachedAt         DateTime @default(now())

  finding          AuditFinding     @relation(fields: [findingId], references: [id], onDelete: Cascade)
  approvalInstance ApprovalInstance @relation(fields: [approvalInstanceId], references: [id], onDelete: Cascade)

  @@unique([findingId, approvalInstanceId])
  @@index([organizationId])
  @@index([findingId])
  @@map("audit_finding_approvals")
}

model VendorAssessmentApproval {
  id                 String   @id @default(uuid())
  organizationId     String
  vendorAssessmentId String
  approvalInstanceId String
  attachedAt         DateTime @default(now())

  vendorAssessment VendorAssessment @relation(fields: [vendorAssessmentId], references: [id], onDelete: Cascade)
  approvalInstance ApprovalInstance @relation(fields: [approvalInstanceId], references: [id], onDelete: Cascade)

  @@unique([vendorAssessmentId, approvalInstanceId])
  @@index([organizationId])
  @@index([vendorAssessmentId])
  @@map("vendor_assessment_approvals")
}

model VulnerabilityApproval {
  id                 String   @id @default(uuid())
  organizationId     String
  vulnerabilityId    String
  approvalInstanceId String
  attachedAt         DateTime @default(now())

  vulnerability    Vulnerability    @relation(fields: [vulnerabilityId], references: [id], onDelete: Cascade)
  approvalInstance ApprovalInstance @relation(fields: [approvalInstanceId], references: [id], onDelete: Cascade)

  @@unique([vulnerabilityId, approvalInstanceId])
  @@index([organizationId])
  @@index([vulnerabilityId])
  @@map("vulnerability_approvals")
}

model IncidentApproval {
  id                 String   @id @default(uuid())
  organizationId     String
  incidentId         String
  approvalInstanceId String
  attachedAt         DateTime @default(now())

  incident         Incident         @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  approvalInstance ApprovalInstance @relation(fields: [approvalInstanceId], references: [id], onDelete: Cascade)

  @@unique([incidentId, approvalInstanceId])
  @@index([organizationId])
  @@index([incidentId])
  @@map("incident_approvals")
}

model PolicyExceptionApproval {
  id                 String   @id @default(uuid())
  organizationId     String
  policyExceptionId  String
  approvalInstanceId String
  attachedAt         DateTime @default(now())

  policyException  PolicyException  @relation(fields: [policyExceptionId], references: [id], onDelete: Cascade)
  approvalInstance ApprovalInstance @relation(fields: [approvalInstanceId], references: [id], onDelete: Cascade)

  @@unique([policyExceptionId, approvalInstanceId])
  @@index([organizationId])
  @@index([policyExceptionId])
  @@map("policy_exception_approvals")
}

model EvidenceApproval {
  id                 String   @id @default(uuid())
  organizationId     String
  evidenceId         String
  approvalInstanceId String
  attachedAt         DateTime @default(now())

  evidence         Evidence         @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  approvalInstance ApprovalInstance @relation(fields: [approvalInstanceId], references: [id], onDelete: Cascade)

  @@unique([evidenceId, approvalInstanceId])
  @@index([organizationId])
  @@index([evidenceId])
  @@map("evidence_approvals")
}

// --------------------------------------------------
// PHASE 5 — AI DOCUMENT INTELLIGENCE MODELS
// --------------------------------------------------

enum AnalysisStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  PARTIAL
}

enum ExtractionStatus {
  SUCCESS
  PARTIAL_TRUNCATED
  OCR_UNAVAILABLE
  MALFORMED_DOCUMENT
  UNSUPPORTED_FORMAT
  EMPTY_DOCUMENT
}

enum AnalysisContextType {
  GENERAL
  FRAMEWORK
  FRAMEWORK_REFERENCE
}

enum FindingType {
  KEY_POINT
  OBLIGATION
  DEADLINE
  REQUIREMENT
  RISK
  CONTROL_IMPLICATION
  FRAMEWORK_REFERENCE
  ACTION
  ENTITY
  CONTACT
  AMOUNT
  DATE
}

enum DateCategory {
  DOCUMENT_DATE
  EFFECTIVE_DATE
  DEADLINE
  REVIEW_DATE
  EXPIRY_DATE
  REFERENCE_DATE
}

enum FindingConfidence {
  HIGH
  MEDIUM
  LOW
}

enum FindingReviewStatus {
  UNREVIEWED
  ACCEPTED
  REJECTED
  EDITED
  DISMISSED
}

model DocumentAnalysis {
  id                    String              @id @default(uuid())
  organizationId        String
  evidenceId            String?
  evidenceFileName      String?
  evidenceChecksum      String?
  fingerprint           String
  analysisVersionNumber Int                 @default(1)
  analysisContext       AnalysisContextType @default(GENERAL)
  frameworkId           String?
  frameworkVersionId    String?
  frameworkReferenceId  String?
  status                AnalysisStatus      @default(QUEUED)
  extractionStatus      ExtractionStatus    @default(SUCCESS)
  extractionMethod      String
  isTruncated           Boolean             @default(false)
  truncationReason      String?
  errorMessage          String?
  requestedById         String
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  evidence           Evidence?           @relation(fields: [evidenceId], references: [id], onDelete: SetNull)
  framework          Framework?          @relation(fields: [frameworkId], references: [id], onDelete: SetNull)
  frameworkVersion    FrameworkVersion?   @relation(fields: [frameworkVersionId], references: [id], onDelete: SetNull)
  frameworkReference FrameworkReference? @relation(fields: [frameworkReferenceId], references: [id], onDelete: SetNull)

  runs               AnalysisRun[]
  findings           ExtractedFinding[]

  @@index([organizationId])
  @@index([evidenceId])
  @@index([status])
  @@index([fingerprint])
  @@map("document_analyses")
}

model AnalysisRun {
  id                 String         @id @default(uuid())
  documentAnalysisId String
  providerName       String
  modelTier          ModelTier      @default(TIER_1)
  promptVersion      String         @default("v1.0")
  schemaVersion      String         @default("v1.0")
  promptTokens       Int?
  completionTokens   Int?
  totalTokens        Int?
  durationMs         Int?
  status             AnalysisStatus @default(QUEUED)
  errorMessage       String?
  createdAt          DateTime       @default(now())

  documentAnalysis DocumentAnalysis @relation(fields: [documentAnalysisId], references: [id], onDelete: Cascade)

  @@index([documentAnalysisId])
  @@map("analysis_runs")
}

model ExtractedFinding {
  id                   String              @id @default(uuid())
  documentAnalysisId   String
  organizationId       String
  findingType          FindingType
  dateCategory         DateCategory?

  // Immutable Original AI Output
  aiTitle              String
  aiDescription        String
  aiConfidence         FindingConfidence   @default(MEDIUM)
  aiRawScore           Float?
  aiSourceSnippet      String?
  aiSourcePage         Int?
  aiSourceSection      String?
  aiSourceSheet        String?
  aiSourceCell         String?
  aiSourceRow          Int?
  aiSourceCol          Int?
  aiCharOffsetStart    Int?
  aiCharOffsetEnd      Int?
  aiDueDate            DateTime?
  aiRelativeExpression String?
  aiResponsibleParty   String?
  aiSuggestedFrameworkCode String?
  aiSuggestedReferenceId   String?
  aiSuggestedControlId     String?
  aiSuggestedRiskId        String?
  aiRationale              String?

  // Server-Validated Suggestions
  isValidatedControl   Boolean             @default(false)
  isValidatedRisk      Boolean             @default(false)
  isValidatedReference Boolean             @default(false)

  // Mutable Human Review Layer
  reviewStatus         FindingReviewStatus @default(UNREVIEWED)
  reviewedById         String?
  reviewedAt           DateTime?
  editedTitle          String?
  editedDescription    String?
  editedCategory       FindingType?
  humanComment         String?

  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  documentAnalysis DocumentAnalysis @relation(fields: [documentAnalysisId], references: [id], onDelete: Cascade)
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([documentAnalysisId])
  @@index([organizationId])
  @@index([findingType])
  @@index([reviewStatus])
  @@map("extracted_findings")
}





