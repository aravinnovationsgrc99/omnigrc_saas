datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  ANALYST
  EXTERNAL_AUDITOR
  MSSP_ADMIN
  MSSP_ANALYST
}

enum ProductAccessStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

enum PodRegion {
  INDIA
  UK
  EU
  AUSTRALIA
}

enum PodStatus {
  ACTIVE
  INACTIVE
}

enum FrameworkCode {
  ISO27001
  SOC2
  GDPR
  DPDP
  ISO42001
  HIPAA
}

enum EntitlementStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  EXPIRED
  REVOKED
}

enum FrameworkVersionStatus {
  DRAFT
  ACTIVE
  SUPERSEDED
  RETIRED
}

enum FrameworkReferenceType {
  CLAUSE
  SUBCLAUSE
  ARTICLE
  PARAGRAPH
  SECTION
  CRITERION
  CONTROL
  FOCUS_POINT
  REQUIREMENT
  IMPLEMENTATION_SPECIFICATION
  ANNEX
  DOMAINS
}

enum AssetType {
  HARDWARE
  SOFTWARE
  VENDOR
  DATA_STORE
  OTHER
}

enum AssetCriticality {
  LOW
  MEDIUM
  HIGH
}

enum AssetEnvironment {
  PRODUCTION
  STAGING
  DEVELOPMENT
  OTHER
}

enum RiskStatus {
  OPEN
  IN_TREATMENT
  ACCEPTED
  CLOSED
}

enum MappingStatus {
  SUGGESTED
  APPROVED
  OVERRIDDEN
  REJECTED
}

enum ModelTier {
  TIER_1
  TIER_2
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  UNDER_REVIEW
  COMPLETE
}

enum VulnerabilitySeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum VulnerabilityStatus {
  OPEN
  IN_REMEDIATION
  RESOLVED
  RISK_ACCEPTED
}

enum PolicyStatus {
  DRAFT
  UNDER_REVIEW
  APPROVED
  PUBLISHED
  RETIRED
}

enum PolicyExceptionStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum VendorCriticality {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum VendorStatus {
  ACTIVE
  UNDER_REVIEW
  INACTIVE
}

enum VendorAssessmentStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

enum ObligationCadence {
  ONE_OFF
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum NotificationType {
  DUE_DATE_REMINDER
  MAPPING_OVERRIDDEN
  TASK_ASSIGNED
  POD_STATUS_CHANGED
  WEEKLY_DIGEST
  RISK_ESCALATION
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum OrgType {
  STANDALONE
  MSSP_PROVIDER
  CLIENT_TENANT
}

model Organization {
  id                  String   @id @default(uuid())
  name                String
  type                OrgType  @default(STANDALONE)
  parentOrganizationId String?
  primaryRegion       String   @default("India")
  slackWebhookUrl     String?
  primaryFramework    String?
  onboardingCompleted Boolean  @default(false)
  createdAt           DateTime @default(now())

  parentOrganization  Organization?  @relation("OrgHierarchy", fields: [parentOrganizationId], references: [id], onDelete: SetNull)
  subOrganizations    Organization[] @relation("OrgHierarchy")

  users           User[]
  memberships     OrganizationMembership[]
  departments     Department[]
  projects        Project[]
  regionalPods    RegionalPod[]
  auditLogs       AuditLogEntry[]
  assets          Asset[]
  risks           Risk[]
  controls        Control[]
  riskControls    RiskControl[]
  complianceTasks ComplianceTask[]
  notifications   Notification[]
  invitations     Invitation[]
  vendors         Vendor[]
  vulnerabilities Vulnerability[]
  policies        Policy[]
  policyCategories PolicyCategory[]
  auditPlans      AuditPlan[]
  incidents       Incident[]
  dashboardPreferences UserDashboardPreference[]
  frameworkEntitlements OrganizationFrameworkEntitlement[]
  evidences           Evidence[]
  approvalWorkflows   ApprovalWorkflow[]
  approvalInstances   ApprovalInstance[]
  vendorQuestionnaires VendorQuestionnaire[]
  vendorQuestionnaireSubmissions VendorQuestionnaireSubmission[]
  documentAnalyses    DocumentAnalysis[]
  extractedFindings   ExtractedFinding[]
  deployment          Deployment?
  systemLicenseState  SystemLicenseState?
  controlStateProjection OrganizationControlStateProjection?
  serviceOverrideProjections OrganizationServiceOverrideProjection[]
  manualSourceIntakes ManualSourceIntake[]
  regulatoryObligations RegulatoryObligation[]
  complianceProfile   OrganizationComplianceProfile?
  applicabilityAssessments RegulatoryApplicabilityAssessment[]
  applicabilityHistories   RegulatoryApplicabilityHistory[]
  regulatoryObligationControlMappings RegulatoryObligationControlMapping[]
  regulatoryObligationControlMappingHistories RegulatoryObligationControlMappingHistory[]
  regulatoryControlGapAssessments RegulatoryControlGapAssessment[]
  regulatoryControlGapAssessmentHistories RegulatoryControlGapAssessmentHistory[]

  @@index([parentOrganizationId])
  @@map("organizations")
}

enum OrganizationControlStateEnum {
  PENDING
  ACTIVE
  SUSPENDED
  DISABLED
  DECOMMISSIONED
}

model OrganizationControlStateProjection {
  id             String                       @id @default(uuid())
  organizationId String                       @unique
  state          OrganizationControlStateEnum @default(PENDING)
  sequence       BigInt                       @default(1)
  reason         String?
  receivedAt     DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([state])
  @@map("organization_control_state_projections")
}

enum DataPlaneServiceStateEnum {
  AVAILABLE
  DISABLED
  TECHNICAL_OUTAGE
  COMMERCIAL_DISABLED
}

model GlobalServiceStateProjection {
  id             String                    @id @default(uuid())
  capabilityCode String                    @unique
  state          DataPlaneServiceStateEnum @default(AVAILABLE)
  sequence       BigInt                    @default(1)
  reason         String?
  receivedAt     DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@index([capabilityCode])
  @@index([state])
  @@map("global_service_state_projections")
}

model OrganizationServiceOverrideProjection {
  id             String                    @id @default(uuid())
  organizationId String
  capabilityCode String
  overrideState  DataPlaneServiceStateEnum
  sequence       BigInt                    @default(1)
  reason         String?
  receivedAt     DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, capabilityCode])
  @@index([organizationId])
  @@index([capabilityCode])
  @@map("organization_service_override_projections")
}

model Asset {
  id                  String           @id @default(uuid())
  organizationId      String
  departmentId        String?
  projectId           String?
  name                String
  type                AssetType
  description         String?
  owner               String
  criticality         AssetCriticality @default(MEDIUM)
  vendorName          String?
  dataResidencyRegion String?
  department          String?
  environment         AssetEnvironment @default(PRODUCTION)
  isManaged           Boolean          @default(true)
  lastScannedAt       DateTime?
  maintenanceDueDate  DateTime?
  vendorId            String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  createdById         String
  deletedAt           DateTime?

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentRef       Department?          @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  projectRef          Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  vendor              Vendor?              @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  risks               Risk[]
  vulnerabilityAssets VulnerabilityAsset[]
  incidents           Incident[]

  @@index([organizationId])
  @@index([departmentId])
  @@index([projectId])
  @@index([deletedAt])
  @@index([type])
  @@index([criticality])
  @@index([vendorId])
  @@map("assets")
}

model Risk {
  id                   String              @id @default(uuid())
  organizationId       String
  departmentId         String?
  projectId            String?
  title                String
  description          String?
  likelihood           Int
  impact               Int
  score                Int
  status               RiskStatus          @default(OPEN)
  owner                String
  assetId              String?
  frameworkId          String?
  frameworkReferenceId String?
  treatmentPlan        String?
  category             String?
  residualLikelihood   Int?
  residualImpact       Int?
  residualScore        Int?
  treatmentStrategy    String?
  treatmentOwner       String?
  treatmentDueDate     DateTime?
  treatmentStatus      String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  createdById          String
  deletedAt            DateTime?

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentRef      Department?         @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  projectRef         Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  asset              Asset?              @relation(fields: [assetId], references: [id], onDelete: SetNull)
  framework          Framework?          @relation(fields: [frameworkId], references: [id], onDelete: SetNull)
  frameworkReference FrameworkReference? @relation(fields: [frameworkReferenceId], references: [id], onDelete: SetNull)
  vendorAssessments  VendorAssessment[]
  auditFindings      AuditFinding[]
  evidenceAssociations RiskEvidence[]
  approvalAssociations RiskApproval[]
  controlAssociations  RiskControl[]

  @@unique([id, organizationId])
  @@index([organizationId])
  @@index([departmentId])
  @@index([projectId])
  @@index([deletedAt])
  @@index([status])
  @@index([score])
  @@index([category])
  @@index([assetId])
  @@index([frameworkId])
  @@index([frameworkReferenceId])
  @@map("risks")
}

model User {
  id                 String   @id @default(uuid())
  organizationId     String
  name               String
  email              String   @unique
  passwordHash       String
  role                  Role         @default(ANALYST)
  emailNotifications    Boolean      @default(true)
  passwordSetupRequired Boolean      @default(false)
  createdAt             DateTime     @default(now())

  organization        Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships         OrganizationMembership[] @relation("UserMemberships")
  revokedMemberships  OrganizationMembership[] @relation("RevokedMemberships")
  notifications       Notification[]
  invitationsSent     Invitation[]             @relation("InvitedUsers")
  dashboardPreferences UserDashboardPreference[]

  @@index([organizationId])
  @@map("users")
}

model Notification {
  id             String           @id @default(uuid())
  organizationId String
  userId         String
  type           NotificationType
  message        String
  entityType     String
  entityId       String
  read           Boolean          @default(false)
  emailSentAt    DateTime?
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId])
  @@index([read])
  @@map("notifications")
}

model Invitation {
  id             String           @id @default(uuid())
  organizationId String
  email          String
  role           Role             @default(ANALYST)
  tokenHash      String           @unique
  status         InvitationStatus @default(PENDING)
  invitedById    String
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InvitedUsers", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@index([status])
  @@index([tokenHash])
  @@map("invitations")
}

model RegionalPod {
  id             String    @id @default(uuid())
  organizationId String
  region         PodRegion
  status         PodStatus @default(INACTIVE)
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, region])
  @@index([organizationId])
  @@map("regional_pods")
}

model Framework {
  id        String        @id @default(uuid())
  code      FrameworkCode @unique
  name      String
  createdAt DateTime      @default(now())

  clauses          FrameworkClause[]
  versions         FrameworkVersion[]
  entitlements     OrganizationFrameworkEntitlement[]
  documentAnalyses DocumentAnalysis[]
  risks            Risk[]
  auditPlans       AuditPlan[]

  @@map("frameworks")
}

model FrameworkVersion {
  id            String                 @id @default(uuid())
  frameworkId   String
  version       String
  name          String
  status        FrameworkVersionStatus @default(ACTIVE)
  publisher     String?
  effectiveDate DateTime?
  provenance    Json?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  framework    Framework                          @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  references   FrameworkReference[]
  entitlements OrganizationFrameworkEntitlement[]
  documentAnalyses DocumentAnalysis[]
  auditPlans       AuditPlan[]

  @@unique([frameworkId, version])
  @@index([frameworkId])
  @@index([status])
  @@map("framework_versions")
}

model OrganizationFrameworkEntitlement {
  id             String            @id @default(uuid())
  organizationId String
  frameworkId    String
  versionId      String?
  status         EntitlementStatus @default(DRAFT)
  grantedAt      DateTime          @default(now())
  expiresAt      DateTime?
  source         String            @default("ARAV_CONTROL_PLANE")
  provenance     Json?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  framework        Framework         @relation(fields: [frameworkId], references: [id], onDelete: Restrict)
  frameworkVersion FrameworkVersion? @relation(fields: [versionId], references: [id], onDelete: Restrict)

  @@unique([organizationId, frameworkId, versionId])
  @@index([organizationId])
  @@index([frameworkId])
  @@index([versionId])
  @@index([status])
  @@map("organization_framework_entitlements")
}

model FrameworkReference {
  id                 String                 @id @default(uuid())
  frameworkVersionId String
  parentRefId        String?
  type               FrameworkReferenceType
  identifier         String
  title              String
  description        String?
  normativeText      String?
  sortOrder          Int                    @default(0)
  provenance         Json?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  frameworkVersion FrameworkVersion     @relation(fields: [frameworkVersionId], references: [id], onDelete: Cascade)
  parentRef        FrameworkReference?  @relation("ReferenceHierarchy", fields: [parentRefId], references: [id], onDelete: SetNull)
  childRefs        FrameworkReference[] @relation("ReferenceHierarchy")

  mappings ControlFrameworkMapping[]
  evidenceAssociations EvidenceFrameworkReference[]
  approvalInstances ApprovalInstance[]
  documentAnalyses DocumentAnalysis[]
  risks            Risk[]
  auditPlanReferences AuditPlanFrameworkReference[]
  obligationMappings RegulatoryObligationControlMapping[]

  @@unique([frameworkVersionId, identifier])
  @@index([frameworkVersionId])
  @@index([parentRefId])
  @@index([type])
  @@map("framework_references")
}

model FrameworkClause {
  id          String   @id @default(uuid())
  frameworkId String
  code        String
  title       String
  createdAt   DateTime @default(now())

  framework Framework               @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  mappings  ControlFrameworkMapping[]

  @@index([frameworkId])
  @@map("framework_clauses")
}

model Control {
  id             String    @id @default(uuid())
  organizationId String
  departmentId   String?
  projectId      String?
  name           String
  description    String
  category       String?
  createdById    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization    Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentRef   Department?               @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  projectRef      Project?                  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  mappings        ControlFrameworkMapping[]
  complianceTasks ComplianceTask[]
  auditCheckItems AuditCheckItem[]
  evidenceAssociations ControlEvidence[]
  approvalAssociations ControlApproval[]
  riskAssociations     RiskControl[]
  regulatoryMappings   RegulatoryObligationControlMapping[]
  gapAssessments       RegulatoryControlGapAssessment[]

  @@unique([id, organizationId])
  @@index([organizationId])
  @@index([departmentId])
  @@index([projectId])
  @@index([deletedAt])
  @@map("controls")
}

model ControlFrameworkMapping {
  id                   String              @id @default(uuid())
  controlId            String
  frameworkClauseId    String?
  frameworkReferenceId String?
  status               MappingStatus       @default(SUGGESTED)
  confidenceScore      Float?
  modelTier            ModelTier           @default(TIER_1)
  reviewedById         String?
  reviewedAt           DateTime?
  createdAt            DateTime            @default(now())

  control            Control             @relation(fields: [controlId], references: [id], onDelete: Cascade)
  frameworkClause    FrameworkClause?    @relation(fields: [frameworkClauseId], references: [id], onDelete: SetNull)
  frameworkReference FrameworkReference? @relation(fields: [frameworkReferenceId], references: [id], onDelete: SetNull)

  @@unique([controlId, frameworkClauseId])
  @@unique([controlId, frameworkReferenceId])
  @@index([controlId])
  @@index([frameworkClauseId])
  @@index([frameworkReferenceId])
  @@index([status])
  @@map("control_framework_mappings")
}

enum RiskControlMitigationType {
  PREVENTATIVE
  DETECTIVE
  CORRECTIVE
  COMPENSATING
}

model RiskControl {
  id             String                    @id @default(uuid())
  organizationId String
  riskId         String
  controlId      String
  mitigationType RiskControlMitigationType @default(PREVENTATIVE)
  notes          String?
  createdAt      DateTime                  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  risk         Risk         @relation(fields: [riskId, organizationId], references: [id, organizationId], onDelete: Cascade)
  control      Control      @relation(fields: [controlId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([riskId, controlId])
  @@index([organizationId])
  @@index([riskId])
  @@index([controlId])
  @@map("risk_controls")
}

model ComplianceTask {
  id                  String            @id @default(uuid())
  organizationId      String
  departmentId        String?
  projectId           String?
  title               String
  description         String?
  status              TaskStatus        @default(NOT_STARTED)
  owner               String
  dueDate             DateTime?
  controlId           String?
  cadence             ObligationCadence @default(ONE_OFF)
  category            String?
  obligationReference String?
  lastCompletedAt     DateTime?
  nextDueDate         DateTime?
  createdById         String
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  deletedAt           DateTime?

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentRef     Department?        @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  projectRef        Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  control           Control?           @relation(fields: [controlId], references: [id], onDelete: SetNull)
  vendorAssessments VendorAssessment[]

  @@index([organizationId])
  @@index([departmentId])
  @@index([projectId])
  @@index([deletedAt])
  @@index([status])
  @@index([dueDate])
  @@index([controlId])
  @@map("compliance_tasks")
}

model AuditLogEntry {
  id             String   @id @default(uuid())
  organizationId String
  actorId        String
  action         String
  entityType     String
  entityId       String
  metadata       Json
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([actorId])
  @@map("audit_log_entries")
}

enum DeploymentModel {
  SAAS_MULTI_TENANT
  MSSP_SHARED
  PRIVATE_MSSP
  SELF_HOSTED
}

model Deployment {
  id                       String          @id @default(uuid())
  organizationId           String          @unique
  controlPlaneDeploymentId String          @unique
  modelType                DeploymentModel @default(SAAS_MULTI_TENANT)
  externalRefId            String?         @unique
  status                   String          @default("ACTIVE")
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt

  organization             Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([controlPlaneDeploymentId])
  @@map("deployments")
}

model SystemLicenseState {
  id                 String   @id @default(uuid())
  deploymentId       String
  organizationId     String   @unique
  signedArtifactJson Json
  verifiedAt         DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([deploymentId])
  @@map("system_license_state")
}

// Phase 11 Models: Vendor, VendorAssessment, Vulnerability, VulnerabilityAsset, Policy, PolicyVersion, PolicyAttestation, PolicyException

model Vendor {
  id                String           @id @default(uuid())
  organizationId    String
  departmentId      String?
  projectId         String?
  name              String
  description       String?
  category          String?
  criticality       VendorCriticality @default(MEDIUM)
  status            VendorStatus     @default(ACTIVE)
  owner             String
  department        String?
  reviewCadenceDays Int              @default(365)
  lastReviewedAt    DateTime?
  nextReviewDate    DateTime?
  websiteUrl        String?
  dueDiligenceStatus String?
  createdById       String
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  deletedAt         DateTime?

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentRef Department?        @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  projectRef   Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assets       Asset[]
  assessments  VendorAssessment[]
  evidenceAssociations VendorEvidence[]
  questionnaireSubmissions VendorQuestionnaireSubmission[]

  @@index([organizationId])
  @@index([departmentId])
  @@index([projectId])
  @@index([deletedAt])
  @@index([status])
  @@map("vendors")
}

model VendorAssessment {
  id               String                 @id @default(uuid())
  organizationId   String
  vendorId         String
  title            String
  score            Int?
  status           VendorAssessmentStatus @default(SCHEDULED)
  evaluatorId      String
  riskId           String?
  complianceTaskId String?
  completedAt      DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  vendor         Vendor          @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  risk           Risk?           @relation(fields: [riskId], references: [id], onDelete: SetNull)
  complianceTask ComplianceTask? @relation(fields: [complianceTaskId], references: [id], onDelete: SetNull)
  approvalAssociations VendorAssessmentApproval[]
  actions              VendorAssessmentAction[]
  questionnaireSubmissions VendorQuestionnaireSubmission[]

  @@index([organizationId])
  @@index([vendorId])
  @@map("vendor_assessments")
}

model VendorQuestionnaire {
  id             String   @id @default(uuid())
  organizationId String
  title          String
  description    String?
  version        String   @default("1.0")
  status         String   @default("ACTIVE")
  questions      Json
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  submissions    VendorQuestionnaireSubmission[]

  @@index([organizationId])
  @@index([status])
  @@map("vendor_questionnaires")
}

model VendorQuestionnaireSubmission {
  id              String   @id @default(uuid())
  organizationId  String
  vendorId        String
  questionnaireId String
  assessmentId    String?
  status          String   @default("PENDING")
  answers         Json
  submittedAt     DateTime?
  submittedBy     String?
  reviewedAt      DateTime?
  reviewedById    String?
  score           Int?
  reviewNotes     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendor          Vendor              @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  questionnaire   VendorQuestionnaire @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)
  assessment      VendorAssessment?   @relation(fields: [assessmentId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([vendorId])
  @@index([questionnaireId])
  @@index([status])
  @@map("vendor_questionnaire_submissions")
}

model VendorAssessmentAction {
  id             String     @id @default(uuid())
  organizationId String
  assessmentId   String
  title          String
  description    String?
  actionType     String     @default("REMEDIATION")
  owner          String
  dueDate        DateTime?
  status         CapaStatus @default(OPEN)
  completedAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  assessment     VendorAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([assessmentId])
  @@index([status])
  @@map("vendor_assessment_actions")
}

model Vulnerability {
