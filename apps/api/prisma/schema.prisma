datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  ANALYST
  MSSP_ADMIN
  MSSP_ANALYST
}

enum PodRegion {
  INDIA
  UK
  EU
  AUSTRALIA
}

enum PodStatus {
  ACTIVE
  INACTIVE
}

enum FrameworkCode {
  ISO27001
  SOC2
  GDPR
  DPDP
  ISO42001
  HIPAA
}

enum AssetType {
  HARDWARE
  SOFTWARE
  VENDOR
  DATA_STORE
  OTHER
}

enum AssetCriticality {
  LOW
  MEDIUM
  HIGH
}

enum AssetEnvironment {
  PRODUCTION
  STAGING
  DEVELOPMENT
  OTHER
}

enum RiskStatus {
  OPEN
  IN_TREATMENT
  ACCEPTED
  CLOSED
}

enum MappingStatus {
  SUGGESTED
  APPROVED
  OVERRIDDEN
  REJECTED
}

enum ModelTier {
  TIER_1
  TIER_2
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  UNDER_REVIEW
  COMPLETE
}

enum VulnerabilitySeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum VulnerabilityStatus {
  OPEN
  IN_REMEDIATION
  RESOLVED
  RISK_ACCEPTED
}

enum PolicyStatus {
  DRAFT
  UNDER_REVIEW
  APPROVED
  PUBLISHED
  RETIRED
}

enum PolicyExceptionStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum VendorCriticality {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum VendorStatus {
  ACTIVE
  UNDER_REVIEW
  INACTIVE
}

enum VendorAssessmentStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

enum ObligationCadence {
  ONE_OFF
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum NotificationType {
  DUE_DATE_REMINDER
  MAPPING_OVERRIDDEN
  TASK_ASSIGNED
  POD_STATUS_CHANGED
  WEEKLY_DIGEST
  RISK_ESCALATION
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum OrgType {
  STANDALONE
  MSSP_PROVIDER
  CLIENT_TENANT
}

model Organization {
  id                  String   @id @default(uuid())
  name                String
  type                OrgType  @default(STANDALONE)
  parentOrganizationId String?
  primaryRegion       String   @default("India")
  slackWebhookUrl     String?
  primaryFramework    String?
  onboardingCompleted Boolean  @default(false)
  createdAt           DateTime @default(now())

  parentOrganization  Organization?  @relation("OrgHierarchy", fields: [parentOrganizationId], references: [id], onDelete: SetNull)
  subOrganizations    Organization[] @relation("OrgHierarchy")

  users           User[]
  regionalPods    RegionalPod[]
  auditLogs       AuditLogEntry[]
  assets          Asset[]
  risks           Risk[]
  controls        Control[]
  complianceTasks ComplianceTask[]
  notifications   Notification[]
  invitations     Invitation[]
  vendors         Vendor[]
  vulnerabilities Vulnerability[]
  policies        Policy[]
  auditPlans      AuditPlan[]
  incidents       Incident[]
  dashboardPreferences UserDashboardPreference[]

  @@index([parentOrganizationId])
  @@map("organizations")
}

model Asset {
  id                  String           @id @default(uuid())
  organizationId      String
  name                String
  type                AssetType
  description         String?
  owner               String
  criticality         AssetCriticality @default(MEDIUM)
  vendorName          String?
  dataResidencyRegion String?
  department          String?
  environment         AssetEnvironment @default(PRODUCTION)
  isManaged           Boolean          @default(true)
  lastScannedAt       DateTime?
  maintenanceDueDate  DateTime?
  vendorId            String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  createdById         String
  deletedAt           DateTime?

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendor              Vendor?              @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  risks               Risk[]
  vulnerabilityAssets VulnerabilityAsset[]
  incidents           Incident[]

  @@index([organizationId])
  @@index([deletedAt])
  @@index([type])
  @@index([criticality])
  @@index([vendorId])
  @@map("assets")
}

model Risk {
  id             String     @id @default(uuid())
  organizationId String
  title          String
  description    String?
  likelihood     Int
  impact         Int
  score          Int
  status         RiskStatus @default(OPEN)
  owner          String
  assetId        String?
  treatmentPlan  String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  createdById    String
  deletedAt      DateTime?

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  asset             Asset?             @relation(fields: [assetId], references: [id], onDelete: SetNull)
  vendorAssessments VendorAssessment[]
  auditFindings     AuditFinding[]

  @@index([organizationId])
  @@index([deletedAt])
  @@index([status])
  @@index([score])
  @@index([assetId])
  @@map("risks")
}

model User {
  id                 String   @id @default(uuid())
  organizationId     String
  name               String
  email              String   @unique
  passwordHash       String
  role                  Role         @default(ANALYST)
  emailNotifications    Boolean      @default(true)
  passwordSetupRequired Boolean      @default(false)
  createdAt             DateTime     @default(now())

  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  notifications   Notification[]
  invitationsSent Invitation[]   @relation("InvitedUsers")
  dashboardPreferences UserDashboardPreference[]

  @@index([organizationId])
  @@map("users")
}

model Notification {
  id             String           @id @default(uuid())
  organizationId String
  userId         String
  type           NotificationType
  message        String
  entityType     String
  entityId       String
  read           Boolean          @default(false)
  emailSentAt    DateTime?
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId])
  @@index([read])
  @@map("notifications")
}

model Invitation {
  id             String           @id @default(uuid())
  organizationId String
  email          String
  role           Role             @default(ANALYST)
  tokenHash      String           @unique
  status         InvitationStatus @default(PENDING)
  invitedById    String
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InvitedUsers", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@index([status])
  @@index([tokenHash])
  @@map("invitations")
}

model RegionalPod {
  id             String    @id @default(uuid())
  organizationId String
  region         PodRegion
  status         PodStatus @default(INACTIVE)
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, region])
  @@index([organizationId])
  @@map("regional_pods")
}

model Framework {
  id        String        @id @default(uuid())
  code      FrameworkCode @unique
  name      String
  createdAt DateTime      @default(now())

  clauses FrameworkClause[]

  @@map("frameworks")
}

model FrameworkClause {
  id          String   @id @default(uuid())
  frameworkId String
  code        String
  title       String
  createdAt   DateTime @default(now())

  framework Framework               @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  mappings  ControlFrameworkMapping[]

  @@index([frameworkId])
  @@map("framework_clauses")
}

model Control {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  description    String
  category       String?
  createdById    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization    Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mappings        ControlFrameworkMapping[]
  complianceTasks ComplianceTask[]
  auditCheckItems AuditCheckItem[]

  @@index([organizationId])
  @@index([deletedAt])
  @@map("controls")
}

model ControlFrameworkMapping {
  id                String        @id @default(uuid())
  controlId         String
  frameworkClauseId String
  status            MappingStatus @default(SUGGESTED)
  confidenceScore   Float?
  modelTier         ModelTier     @default(TIER_1)
  reviewedById      String?
  reviewedAt        DateTime?
  createdAt         DateTime      @default(now())

  control         Control         @relation(fields: [controlId], references: [id], onDelete: Cascade)
  frameworkClause FrameworkClause @relation(fields: [frameworkClauseId], references: [id], onDelete: Cascade)

  @@unique([controlId, frameworkClauseId])
  @@index([controlId])
  @@index([frameworkClauseId])
  @@index([status])
  @@map("control_framework_mappings")
}

model ComplianceTask {
  id                  String            @id @default(uuid())
  organizationId      String
  title               String
  description         String?
  status              TaskStatus        @default(NOT_STARTED)
  owner               String
  dueDate             DateTime?
  controlId           String?
  cadence             ObligationCadence @default(ONE_OFF)
  category            String?
  obligationReference String?
  lastCompletedAt     DateTime?
  nextDueDate         DateTime?
  createdById         String
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  deletedAt           DateTime?

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  control           Control?           @relation(fields: [controlId], references: [id], onDelete: SetNull)
  vendorAssessments VendorAssessment[]

  @@index([organizationId])
  @@index([deletedAt])
  @@index([status])
  @@index([dueDate])
  @@index([controlId])
  @@map("compliance_tasks")
}

model AuditLogEntry {
  id             String   @id @default(uuid())
  organizationId String
  actorId        String
  action         String
  entityType     String
  entityId       String
  metadata       Json
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([actorId])
  @@map("audit_log_entries")
}

model SystemLicenseState {
  id                 String   @id @default("current")
  deploymentId       String
  organizationId     String
  signedArtifactJson Json
  verifiedAt         DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("system_license_state")
}

// Phase 11 Models: Vendor, VendorAssessment, Vulnerability, VulnerabilityAsset, Policy, PolicyVersion, PolicyAttestation, PolicyException

model Vendor {
  id                String           @id @default(uuid())
  organizationId    String
  name              String
  description       String?
  category          String?
  criticality       VendorCriticality @default(MEDIUM)
  status            VendorStatus     @default(ACTIVE)
  owner             String
  department        String?
  reviewCadenceDays Int              @default(365)
  lastReviewedAt    DateTime?
  nextReviewDate    DateTime?
  websiteUrl        String?
  createdById       String
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  deletedAt         DateTime?

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assets       Asset[]
  assessments  VendorAssessment[]

  @@index([organizationId])
  @@index([deletedAt])
  @@index([status])
  @@map("vendors")
}

model VendorAssessment {
  id               String                 @id @default(uuid())
  organizationId   String
  vendorId         String
  title            String
  score            Int?
  status           VendorAssessmentStatus @default(SCHEDULED)
  evaluatorId      String
  riskId           String?
  complianceTaskId String?
  completedAt      DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  vendor         Vendor          @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  risk           Risk?           @relation(fields: [riskId], references: [id], onDelete: SetNull)
  complianceTask ComplianceTask? @relation(fields: [complianceTaskId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([vendorId])
  @@map("vendor_assessments")
}

model Vulnerability {
  id               String                @id @default(uuid())
  organizationId   String
  cveId            String?
  title            String
  description      String?
  severity         VulnerabilitySeverity @default(MEDIUM)
  status           VulnerabilityStatus   @default(OPEN)
  discoveredAt     DateTime              @default(now())
  lastSeenAt       DateTime              @default(now())
  remediationOwner String
  dueDate          DateTime?
  remediationNotes String?
  createdById      String
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  deletedAt        DateTime?

  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  affectedAssets VulnerabilityAsset[]

  @@index([organizationId])
  @@index([status])
  @@index([severity])
  @@index([deletedAt])
  @@map("vulnerabilities")
}

model VulnerabilityAsset {
  id              String   @id @default(uuid())
  organizationId  String
  vulnerabilityId String
  assetId         String
  createdAt       DateTime @default(now())

  vulnerability Vulnerability @relation(fields: [vulnerabilityId], references: [id], onDelete: Cascade)
  asset         Asset         @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([vulnerabilityId, assetId])
  @@index([organizationId])
  @@index([vulnerabilityId])
  @@index([assetId])
  @@map("vulnerability_assets")
}

model Policy {
  id                 String       @id @default(uuid())
  organizationId     String
  code               String
  title              String
  description        String?
  category           String
  status             PolicyStatus @default(DRAFT)
  ownerId            String
  businessUnit       String?
  publishedVersionId String?
  effectiveDate      DateTime?
  reviewDate         DateTime?
  reviewCadenceDays  Int          @default(365)
  createdById        String
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  deletedAt          DateTime?

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  publishedVersion PolicyVersion?    @relation("PublishedPolicyVersion", fields: [publishedVersionId], references: [id], onDelete: SetNull)
  versions         PolicyVersion[]   @relation("PolicyVersions")
  exceptions       PolicyException[]

  @@index([organizationId])
  @@index([status])
  @@index([deletedAt])
  @@map("policies")
}

model PolicyVersion {
  id            String   @id @default(uuid())
  policyId      String
  versionNumber String
  content       String
  changeLog     String?
  createdById   String
  createdAt     DateTime @default(now())

  policy            Policy              @relation("PolicyVersions", fields: [policyId], references: [id], onDelete: Cascade)
  publishedInPolicy Policy[]            @relation("PublishedPolicyVersion")
  attestations      PolicyAttestation[]

  @@unique([policyId, versionNumber])
  @@index([policyId])
  @@map("policy_versions")
}

model PolicyAttestation {
  id              String   @id @default(uuid())
  organizationId  String
  policyVersionId String
  userId          String
  attestedAt      DateTime @default(now())
  ipAddress       String?

  policyVersion PolicyVersion @relation(fields: [policyVersionId], references: [id], onDelete: Cascade)

  @@unique([policyVersionId, userId])
  @@index([organizationId])
  @@map("policy_attestations")
}

model PolicyException {
  id             String                @id @default(uuid())
  organizationId String
  policyId       String
  title          String
  reason         String
  requestedById  String
  approvedById   String?
  status         PolicyExceptionStatus @default(PENDING)
  expiresAt      DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  policy Policy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([policyId])
  @@map("policy_exceptions")
}

// Phase 12 Models: AuditPlan, AuditSchedule, AuditAssessment, AuditCheckItem, AuditEvidence, AuditFinding, AuditCapa

enum AuditPlanStatus {
  DRAFT
  PLANNED
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

enum AuditScheduleStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AuditAssessmentStatus {
  IN_PROGRESS
  UNDER_REVIEW
  COMPLETED
}

enum AuditCheckResult {
  NOT_EVALUATED
  COMPLIANT
  PARTIALLY_COMPLIANT
  NON_COMPLIANT
  NOT_APPLICABLE
}

enum FindingStatus {
  OPEN
  IN_REMEDIATION
  READY_FOR_VERIFICATION
  VERIFIED
  CLOSED
}

enum CapaStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  VERIFIED
  CLOSED
}

model AuditPlan {
  id               String          @id @default(uuid())
  organizationId   String
  title            String
  objective        String?
  scope            String?
  frameworkCode    String?
  ownerId          String
  plannedStartDate DateTime?
  plannedEndDate   DateTime?
  status           AuditPlanStatus @default(DRAFT)
  createdById      String
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  schedules    AuditSchedule[]
  assessments  AuditAssessment[]

  @@index([organizationId])
  @@index([status])
  @@map("audit_plans")
}

model AuditSchedule {
  id                 String              @id @default(uuid())
  organizationId     String
  auditPlanId        String
  scheduledStartDate DateTime
  scheduledEndDate   DateTime
  leadAuditorId      String
  status             AuditScheduleStatus @default(SCHEDULED)
  recurrence         ObligationCadence?
  nextAuditDate      DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  auditPlan   AuditPlan         @relation(fields: [auditPlanId], references: [id], onDelete: Cascade)
  assessments AuditAssessment[]

  @@index([organizationId])
  @@index([auditPlanId])
  @@index([status])
  @@map("audit_schedules")
}

model AuditAssessment {
  id             String                @id @default(uuid())
  organizationId String
  auditPlanId    String
  scheduleId     String?
  auditorId      String
  status         AuditAssessmentStatus @default(IN_PROGRESS)
  score          Float                 @default(0)
  summary        String?
  startedAt      DateTime              @default(now())
  completedAt    DateTime?
  createdById    String
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  auditPlan  AuditPlan        @relation(fields: [auditPlanId], references: [id], onDelete: Cascade)
  schedule   AuditSchedule?   @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  checkItems AuditCheckItem[]
  findings   AuditFinding[]

  @@index([organizationId])
  @@index([auditPlanId])
  @@index([status])
  @@map("audit_assessments")
}

model AuditCheckItem {
  id             String           @id @default(uuid())
  organizationId String
  assessmentId   String
  controlId      String?
  title          String
  description    String?
  result         AuditCheckResult @default(NOT_EVALUATED)
  notes          String?
  createdById    String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  assessment AuditAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  control    Control?         @relation(fields: [controlId], references: [id], onDelete: SetNull)
  evidence   AuditEvidence[]
  findings   AuditFinding[]

  @@index([organizationId])
  @@index([assessmentId])
  @@index([controlId])
  @@index([result])
  @@map("audit_check_items")
}

model AuditEvidence {
  id             String   @id @default(uuid())
  organizationId String
  checkItemId    String?
  findingId      String?
  fileName       String
  fileUrl        String
  fileSize       Int?
  mimeType       String?
  uploadedById   String
  createdAt      DateTime @default(now())

  checkItem AuditCheckItem? @relation(fields: [checkItemId], references: [id], onDelete: Cascade)
  finding   AuditFinding?   @relation(fields: [findingId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([checkItemId])
  @@index([findingId])
  @@map("audit_evidences")
}

model AuditFinding {
  id                String                @id @default(uuid())
  organizationId    String
  assessmentId      String
  checkItemId       String?
  title             String
  description       String?
  severity          VulnerabilitySeverity @default(MEDIUM)
  status            FindingStatus         @default(OPEN)
  ownerId           String
  dueDate           DateTime?
  riskId            String?
  remediationPlan   String?
  verificationNotes String?
  verifiedById      String?
  verifiedAt        DateTime?
  createdById       String
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  assessment AuditAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  checkItem  AuditCheckItem? @relation(fields: [checkItemId], references: [id], onDelete: SetNull)
  risk       Risk?           @relation(fields: [riskId], references: [id], onDelete: SetNull)
  capas      AuditCapa[]
  evidence   AuditEvidence[]

  @@index([organizationId])
  @@index([assessmentId])
  @@index([status])
  @@index([severity])
  @@index([ownerId])
  @@map("audit_findings")
}

model AuditCapa {
  id               String     @id @default(uuid())
  organizationId   String
  findingId        String
  title            String
  correctiveAction String
  preventiveAction String?
  ownerId          String
  dueDate          DateTime?
  status           CapaStatus @default(OPEN)
  completedAt      DateTime?
  verifiedById     String?
  verifiedAt       DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  finding AuditFinding @relation(fields: [findingId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([findingId])
  @@index([status])
  @@map("audit_capas")
}

// Phase 14 Model: UserDashboardPreference

model UserDashboardPreference {
  id             String   @id @default(uuid())
  userId         String
  organizationId String
  configJson     Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
  @@map("user_dashboard_preferences")
}

// Phase 17 Model: Incident Management

enum IncidentSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum IncidentStatus {
  OPEN
  IN_PROGRESS
  CONTAINED
  RESOLVED
  CLOSED
}

model Incident {
  id              String           @id @default(uuid())
  organizationId  String
  title           String
  description     String?
  severity        IncidentSeverity @default(MEDIUM)
  status          IncidentStatus   @default(OPEN)
  owner           String
  detectedAt      DateTime         @default(now())
  containedAt     DateTime?
  resolvedAt      DateTime?
  dueDate         DateTime?
  rootCause       String?
  affectedAssetId String?
  createdById     String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  affectedAsset Asset?       @relation(fields: [affectedAssetId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([status])
  @@index([severity])
  @@index([deletedAt])
  @@map("incidents")
}


