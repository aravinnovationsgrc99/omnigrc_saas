// Phase 17 Model: Incident Management

enum IncidentSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum IncidentStatus {
  OPEN
  IN_PROGRESS
  CONTAINED
  RESOLVED
  CLOSED
}

model Incident {
  id              String           @id @default(uuid())
  organizationId  String
  departmentId    String?
  projectId       String?
  title           String
  description     String?
  severity        IncidentSeverity @default(MEDIUM)
  status          IncidentStatus   @default(OPEN)
  owner           String
  detectedAt      DateTime         @default(now())
  containedAt     DateTime?
  resolvedAt      DateTime?
  dueDate         DateTime?
  rootCause       String?
  affectedAssetId String?
  createdById     String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentRef Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  projectRef    Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  affectedAsset Asset?       @relation(fields: [affectedAssetId], references: [id], onDelete: SetNull)
  evidenceAssociations IncidentEvidence[]
  approvalAssociations IncidentApproval[]

  @@index([organizationId])
  @@index([departmentId])
  @@index([projectId])
  @@index([status])
  @@index([severity])
  @@index([deletedAt])
  @@map("incidents")
}

model OrganizationMembership {
  id             String              @id @default(uuid())
  organizationId String
  userId         String
  role           Role                @default(ANALYST)
  status         ProductAccessStatus @default(ACTIVE)
  grantedAt      DateTime            @default(now())
  revokedAt      DateTime?
  revokedById    String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User             @relation("UserMemberships", fields: [userId], references: [id], onDelete: Cascade)
  revokedBy    User?            @relation("RevokedMemberships", fields: [revokedById], references: [id], onDelete: SetNull)
  departments  UserDepartment[]
  projects     UserProject[]

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@index([status])
  @@map("organization_memberships")
}

model Department {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  code           String?
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projects     Project[]
  memberships  UserDepartment[]

  assets          Asset[]
  risks           Risk[]
  controls        Control[]
  policies        Policy[]
  complianceTasks ComplianceTask[]
  vendors         Vendor[]
  vulnerabilities Vulnerability[]
  incidents       Incident[]
  auditPlans      AuditPlan[]
  evidences       Evidence[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("departments")
}

model Project {
  id             String   @id @default(uuid())
  organizationId String
  departmentId   String
  name           String
  code           String?
  description    String?
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department   Department    @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  memberships  UserProject[]

  assets          Asset[]
  risks           Risk[]
  controls        Control[]
  policies        Policy[]
  complianceTasks ComplianceTask[]
  vendors         Vendor[]
  vulnerabilities Vulnerability[]
  incidents       Incident[]
  auditPlans      AuditPlan[]
  evidences       Evidence[]

  @@unique([departmentId, name])
  @@index([organizationId])
  @@index([departmentId])
  @@map("projects")
}

model UserDepartment {
  id           String   @id @default(uuid())
  membershipId String
  departmentId String
  assignedAt   DateTime @default(now())

  membership OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  department Department             @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([membershipId, departmentId])
  @@index([membershipId])
  @@index([departmentId])
  @@map("user_departments")
}

model UserProject {
  id           String   @id @default(uuid())
  membershipId String
  projectId    String
  assignedAt   DateTime @default(now())

  membership OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  project    Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([membershipId, projectId])
  @@index([membershipId])
  @@index([projectId])
  @@map("user_projects")
}

// --------------------------------------------------
// PHASE 3 — UNIVERSAL EVIDENCE & PROOF VAULT MODELS
// --------------------------------------------------

enum EvidenceType {
  DOCUMENT
  SPREADSHEET
  IMAGE
  CONFIG_EXPORT
  SYSTEM_LOG
  CERTIFICATE
  EXTERNAL_LINK
  OTHER
}

enum EvidenceStatus {
  PENDING
  ACTIVE
  QUARANTINED
  ARCHIVED
  DELETED
}

enum EvidenceScanStatus {
  PENDING_SCAN
  CLEAN
  QUARANTINED
  SCAN_FAILED
}

model Evidence {
  id             String             @id @default(uuid())
  organizationId String
  departmentId   String?
  projectId      String?
  title          String
  description    String?
  evidenceType   EvidenceType       @default(DOCUMENT)
  fileName       String
  fileSize       Int
  mimeType       String
  storageKey     String             @unique
  checksum       String?
  status         EvidenceStatus     @default(ACTIVE)
  scanStatus     EvidenceScanStatus @default(CLEAN)
  uploadedById   String
  retentionUntil DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  deletedAt      DateTime?

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentRef Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  projectRef    Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)

  controlAssociations        ControlEvidence[]
  riskAssociations           RiskEvidence[]
  policyAssociations         PolicyEvidence[]
  auditCheckAssociations     AuditCheckItemEvidence[]
  auditFindingAssociations  AuditFindingEvidence[]
  vendorAssociations         VendorEvidence[]
  vulnerabilityAssociations  VulnerabilityEvidence[]
  incidentAssociations       IncidentEvidence[]
  frameworkReferences        EvidenceFrameworkReference[]
  approvalAssociations       EvidenceApproval[]
  documentAnalyses           DocumentAnalysis[]

  @@index([organizationId])
  @@index([departmentId])
  @@index([projectId])
  @@index([status])
  @@index([scanStatus])
  @@index([uploadedById])
  @@map("evidences")
}

model ControlEvidence {
  id             String   @id @default(uuid())
  organizationId String
  controlId      String
  evidenceId     String
