  decisions ApprovalDecision[]

  @@unique([approvalInstanceId, stepNumber])
  @@index([approvalInstanceId])
  @@index([status])
  @@map("approval_instance_steps")
}

model ApprovalDecision {
  id                 String         @id @default(uuid())
